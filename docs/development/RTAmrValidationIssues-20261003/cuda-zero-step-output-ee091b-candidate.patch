     double diffusion_dt = 0.0, dt_forward_euler = 0.0;
 };
 
+// Empty output is legal only when this invocation advanced no timestep.
+// Keep I/O failure independent of that lifecycle exception.
+inline void require_cuda_diffusion_schedule_output(
+    bool output_ok, bool advanced_any_step, std::size_t schedule_count)
+{
+    if (!output_ok)
+        throw std::runtime_error("failed writing CUDA diffusion schedule");
+    if (advanced_any_step && schedule_count == 0)
+        throw std::runtime_error("executed CUDA diffusion has no schedule records");
+}
