diff --git a/tests/host/io/test_diffusion_schedule_output.cpp b/tests/host/io/test_diffusion_schedule_output.cpp
new file mode 100644
index 00000000..de8e8be6
--- /dev/null
+++ b/tests/host/io/test_diffusion_schedule_output.cpp
@@ -0,0 +1,51 @@
+/** Test the zero-step exception without suppressing real diagnostic failures. */
+#include "driver/io/DriverIO.h"
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+int checks = 0;
+void expect(bool ok, const char* reason) {
+    ++checks;
+    if (!ok) throw std::runtime_error(reason);
+}
+template<class F> void rejects(F fn, const char* message) {
+    try { fn(); } catch (const std::runtime_error& e) {
+        expect(std::string(e.what()) == message, "unexpected diagnostic"); return;
+    }
+    throw std::runtime_error("missing required diagnostic");
+}
+}
+
+int main() {
+    using arch::driver::require_cuda_diffusion_schedule_output;
+    require_cuda_diffusion_schedule_output(true, false, 0); ++checks;
+    require_cuda_diffusion_schedule_output(true, true, 4); ++checks;
+    rejects([] { require_cuda_diffusion_schedule_output(true, true, 0); },
+            "executed CUDA diffusion has no schedule records");
+    for (bool advanced : {false, true})
+        for (std::size_t records : {0u, 4u})
+            rejects([=] { require_cuda_diffusion_schedule_output(false, advanced, records); },
+                    "failed writing CUDA diffusion schedule");
+    std::ostringstream failed;
+    failed.setstate(std::ios::badbit);
+    rejects([&] { require_cuda_diffusion_schedule_output(
+                static_cast<bool>(failed), false, 0); },
+            "failed writing CUDA diffusion schedule");
+#ifdef __linux__
+    // The writer flushes and closes before checking state; a buffered write can
+    // look successful before close even though the device rejects every byte.
+    std::ofstream full("/dev/full");
+    expect(static_cast<bool>(full), "cannot open /dev/full regression fixture");
+    full << "macro_step\tstages\n";
+    full.flush(); full.close();
+    expect(!full, "real write failure was not observed");
+    rejects([&] { require_cuda_diffusion_schedule_output(
+                static_cast<bool>(full), false, 0); },
+            "failed writing CUDA diffusion schedule");
+#endif
+    std::cout << "diffusion_schedule_output checks=" << checks << " PASS\n";
+}
