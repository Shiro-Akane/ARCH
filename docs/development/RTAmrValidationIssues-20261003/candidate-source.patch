+                combined.combine(one, weights[j]);
+            }
+            if (combined.values[0] != stages
+                || combined.values[11] < std::abs(combined.values[10])
+                || std::abs(combined.values[10] - previous) > 2e-10L * combined.values[11])
+                return 2;
+            for (int injected = 1; injected <= stages; ++injected) {
+                long double a = 0, b = 0;
+                for (int j = 1; j <= stages; ++j) {
+                    const auto c = DiffFunction::get_rkl_coeffs(order, j, stages);
+                    const long double next = c.mu * a + c.nu * b + (j == injected ? 1 : 0);
+                    b = a; a = next;
+                }
+                if (std::abs(weights[injected] - a) > 2e-10L * std::max(1.0L, std::abs(a)))
+                    return 3;
+                ++impulses;
+            }
+        }
+    int rejected = 0;
+    try { (void)DiffFunction::reflux_repair_weights(DiffFunction::RKLOrder::First, 0); }
+    catch (const std::invalid_argument&) { ++rejected; }
+    try { (void)DiffFunction::reflux_repair_weights(DiffFunction::RKLOrder::Second, 1); }
+    catch (const std::invalid_argument&) { ++rejected; }
+    if (rejected != 2) return 4;
+    const auto rkl2 = DiffFunction::reflux_repair_weights(DiffFunction::RKLOrder::Second, 2);
+    if (rkl2[1] != 1.5 || rkl2[2] != 1) return 5;
+    std::cout << "PASS RKL accounting: " << impulses
+              << " stage impulses; signed/absolute budgets; 2 invalid schedules\n";
+}
diff --git a/validation/rt-reflux-candidate-v1/test_roundoff.cpp b/validation/rt-reflux-candidate-v1/test_roundoff.cpp
new file mode 100644
index 00000000..d1ea9c3c
--- /dev/null
+++ b/validation/rt-reflux-candidate-v1/test_roundoff.cpp
@@ -0,0 +1,137 @@
+// Candidate leaf tests only. No production execution path is changed by this test.
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+#include "numerics/state/StateAdmissibility.h"
+#ifdef __CUDACC__
+#include <cuda_runtime.h>
+#endif
+
+struct Case {
+    double rho = 1.0, volume = 0.25;
+    double fractions[6] = {0.25, 91.0, 92.0, 0.75, 93.0, 94.0};
+    double accounting[14]{};
+    int species = 2, stride = 3, ledger_species = 2, ledger = 1;
+    int status = -1;
+};
+
+ARCH_INLINE void evaluate(Case& value)
+{
+    value.status = static_cast<int>(arch::state::repair_reflux_composition_roundoff(
+        value.rho, value.fractions, value.species, value.stride,
+        {value.ledger ? value.accounting : nullptr, value.ledger_species}, value.volume, 17));
+}
+
+#ifdef __CUDACC__
+__global__ void evaluate_device(Case* cases, int count)
+{
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count) evaluate(cases[i]);
+}
+void checked(cudaError_t code)
+{
+    if (code != cudaSuccess) throw std::runtime_error(cudaGetErrorString(code));
+}
+#endif
+
+int main()
+{
+    try {
+        using arch::state::Status;
+        std::vector<Case> input;
+        std::vector<const char*> names;
+        std::vector<Status> expected;
+        const auto add = [&](const char* name, Case value, Status status) {
+            names.push_back(name); input.push_back(value); expected.push_back(status);
+        };
+        add("valid_mixture", Case{}, Status::valid);
+        Case pure; pure.fractions[0] = 0.0; pure.fractions[3] = 1.0;
+        add("valid_pure",pure,Status::valid);
+        const double real_witnesses[] = {-2.0499299336421651e-143, -1.7291201970583932e-223,
+            -4.6467854312720427e-143, -1.3967681576435428e-250};
+        const char* witness_names[] = {"native_rt", "rt_species", "rt_thermal", "rt_both"};
+        for (int i=0; i<4; ++i) {
+            Case value=pure; value.fractions[0]=real_witnesses[i];
+            add(witness_names[i],value,Status::repaired);
+        }
+        Case near=pure; near.fractions[0]=-1e-15;
+        add("bounded_small_negative",near,Status::repaired);
+        Case large=pure; large.fractions[0]=-1e-6;
+        add("reject_large_negative",large,Status::invalid_composition);
+        Case nan=pure; nan.fractions[0]=std::numeric_limits<double>::quiet_NaN();
+        add("reject_nan",nan,Status::invalid_composition);
+        Case sum=pure; sum.fractions[3]=1.01;
+        add("reject_bad_sum",sum,Status::invalid_composition);
+        Case absent=near; absent.ledger=0;
+        add("reject_unaccounted_repair",absent,Status::invalid_composition);
+        Case mismatch=near; mismatch.ledger_species=1;
+        add("reject_wrong_ledger_shape",mismatch,Status::invalid_composition);
+        Case underflow=pure; underflow.fractions[0]=-1e-310; underflow.volume=1e-20;
+        add("reject_unrepresentable_mass_delta",underflow,Status::invalid_composition);
+        Case bad_rho=near; bad_rho.rho=0;
+        add("reject_zero_density",bad_rho,Status::nonpositive_density);
+        Case empty=pure; empty.species=0; empty.ledger=0;
+        add("zero_species",empty,Status::valid);
+        Case stride=near; stride.stride=0;
+        add("reject_bad_stride",stride,Status::invalid_composition);
+        auto cpu=input;
+        for (std::size_t i=0; i<cpu.size(); ++i) {
+            evaluate(cpu[i]);
+            if (cpu[i].status != static_cast<int>(expected[i])) throw std::runtime_error(names[i]);
+            if (expected[i] != Status::repaired) {
+                if (std::memcmp(cpu[i].fractions,input[i].fractions,sizeof(cpu[i].fractions))
+                    || std::memcmp(cpu[i].accounting,input[i].accounting,sizeof(cpu[i].accounting)))
+                    throw std::runtime_error("non-repair path changed state or accounting");
+            } else {
+                if (cpu[i].fractions[0] != 0.0 || cpu[i].fractions[3] != input[i].fractions[3])
+                    throw std::runtime_error("repair changed nonnegative species");
+                const double delta=(input[i].rho * -input[i].fractions[0])*input[i].volume;
+                const double expected_row[14] = {1,input[i].volume,0,0,0,0,0,0,0,17,delta,delta,0,0};
+                if (std::memcmp(cpu[i].accounting,expected_row,sizeof(expected_row)))
+                    throw std::runtime_error("repair mass was not explicitly and exactly recorded");
+                for (int gap : {1,2,4,5})
+                    if (cpu[i].fractions[gap] != input[i].fractions[gap]) throw std::runtime_error("stride gap changed");
+                const FluidVector fluid{input[i].rho,0,0,0,10*input[i].rho};
+                if (arch::state::validate(fluid,cpu[i].fractions,2,3,1e-30,1e-30,1e30)!=Status::valid)
+                    throw std::runtime_error("existing strict validator still rejects repaired composition");
+            }
+            std::printf("CPU case=%s status=%d passed=1\n",names[i],cpu[i].status);
+        }
+#ifdef __CUDACC__
+        Case* device=nullptr;
+        checked(cudaMalloc(&device,input.size()*sizeof(Case)));
+        checked(cudaMemcpy(device,input.data(),input.size()*sizeof(Case),cudaMemcpyHostToDevice));
+        evaluate_device<<<1,32>>>(device,static_cast<int>(input.size()));
+        checked(cudaGetLastError()); checked(cudaDeviceSynchronize());
+        auto gpu=input;
+        checked(cudaMemcpy(gpu.data(),device,input.size()*sizeof(Case),cudaMemcpyDeviceToHost));
+        checked(cudaFree(device));
+        bool parity_failed=false;
+        for (std::size_t i=0; i<cpu.size(); ++i) {
+            if (gpu[i].status != cpu[i].status
+                || std::memcmp(gpu[i].fractions,cpu[i].fractions,sizeof(cpu[i].fractions))
+                || std::memcmp(gpu[i].accounting,cpu[i].accounting,sizeof(cpu[i].accounting))) {
+                parity_failed=true;
+                std::printf("MISMATCH case=%s cpu_status=%d gpu_status=%d\n",names[i],cpu[i].status,gpu[i].status);
+                for (int k=0;k<6;++k)
+                    if (std::memcmp(&cpu[i].fractions[k],&gpu[i].fractions[k],sizeof(double)))
+                        std::printf("MISMATCH fraction=%d cpu=%.17g gpu=%.17g\n",k,cpu[i].fractions[k],gpu[i].fractions[k]);
+                for (int k=0;k<14;++k)
+                    if (std::memcmp(&cpu[i].accounting[k],&gpu[i].accounting[k],sizeof(double)))
+                        std::printf("MISMATCH accounting=%d cpu=%.17g gpu=%.17g\n",k,cpu[i].accounting[k],gpu[i].accounting[k]);
+            }
+        }
+        if (parity_failed) throw std::runtime_error("CPU/GPU candidate leaf mismatch");
+        std::printf("CUDA_PARITY cases=%zu exact_fields=fractions,status,repair_accounting passed=1\n",cpu.size());
+#else
+        std::printf("CPU_ONLY cases=%zu passed=1\n",cpu.size());
+#endif
+        return 0;
+    } catch (const std::exception& error) {
+        std::fprintf(stderr,"TEST_FAILED %s\n",error.what());
+        return 1;
+    }
+}
