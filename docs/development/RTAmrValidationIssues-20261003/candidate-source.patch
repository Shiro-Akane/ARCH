     }
+
+    std::vector<double> reflux_repair_weights(RKLOrder order, int stages)
+    {
+        if ((order != RKLOrder::First && order != RKLOrder::Second)
+            || stages < (order == RKLOrder::First ? 1 : 2))
+            throw std::invalid_argument("invalid RKL repair accounting schedule");
+        std::vector<double> weights(static_cast<std::size_t>(stages) + 1, 0.0);
+        weights[stages] = 1.0;
+        // Reverse the existing recurrence for GLOBAL conserved mass.
+        // Boundary fluxes remain separate; this is not a cellwise error estimate.
+        for (int j = stages; j >= 2; --j) {
+            const auto c = get_rkl_coeffs(order, j, stages);
+            weights[j - 1] += weights[j] * c.mu;
+            weights[j - 2] += weights[j] * c.nu;
+        }
+        weights[0] = 0.0;
+        // RKL1/2 final source weights are nonnegative despite nu < 0.
+        // Require this before using RepairBudget::combine for absolute budgets.
+        for (int j = 1; j <= stages; ++j)
+            if (!std::isfinite(weights[j]) || weights[j] < 0.0)
+                throw std::runtime_error("invalid final RKL repair source weight");
+        return weights;
+    }
 }
