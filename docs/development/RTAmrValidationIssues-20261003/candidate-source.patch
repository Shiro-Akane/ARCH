+        for (int stages : {1, 2, 3, 5, 16, 32, 64, 128, 256}) {
+            if (order == DiffFunction::RKLOrder::Second && stages == 1) continue;
+            const auto weights = DiffFunction::reflux_repair_weights(order, stages);
+            if (weights[0] != 0 || weights.back() != 1) return 1;
+            arch::state::RepairBudget combined(2);
