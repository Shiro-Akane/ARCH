diff --git a/src/numerics/state/StateAdmissibility.h b/src/numerics/state/StateAdmissibility.h
index 2a4b6329..bc7f5766 100644
--- a/src/numerics/state/StateAdmissibility.h
+++ b/src/numerics/state/StateAdmissibility.h
@@ -126,6 +126,61 @@ ARCH_INLINE Status validate(const FluidVector& fluid, const double* fractions,
     return Status::valid;
 }
 
+// Experimental candidate on an unmerged branch, with explicit repair accounting.
+// Invoke only after ALL reflux contributions to a cell. This is an explicitly
+// accounted roundoff repair, NOT an exactly species-conservative correction.
+// Preserve all nonnegative fractions bit-for-bit. Keep the existing strict
+// validator unchanged and require an audit row before changing any state.
+ARCH_INLINE Status repair_reflux_composition_roundoff(
+    double rho, double* fractions, int species, int stride,
+    RepairView repairs, double cell_volume, int cell)
+{
+    if (!std::isfinite(rho) || !std::isfinite(cell_volume)) return Status::nonfinite;
+    if (!(rho > 0.0) || !(cell_volume > 0.0)) return Status::nonpositive_density;
+    if (species < 0 || stride <= 0 || (species && !fractions))
+        return Status::invalid_composition;
+    if (!species) return Status::valid;
+    // Same small-negative and composition-sum bounds as the existing stage
+    // update/normalization contract. No new user tolerance or validator change.
+    const double negative_bound = 64.0 * std::numeric_limits<double>::epsilon();
+    const double sum_bound = 512.0 * species * std::numeric_limits<double>::epsilon();
+    double before_sum = 0.0, after_sum = 0.0;
+    bool needed = false;
+    for (int s = 0; s < species; ++s) {
+        const double x = fractions[s * stride];
+        if (!std::isfinite(x) || x < -negative_bound) return Status::invalid_composition;
+        before_sum += x;
+        after_sum += std::max(0.0, x);
+        needed = needed || x < 0.0;
+    }
+    if (!std::isfinite(before_sum) || !std::isfinite(after_sum)
+        || std::abs(before_sum - 1.0) > sum_bound
+        || std::abs(after_sum - 1.0) > sum_bound)
+        return Status::invalid_composition;
+    if (!needed) return Status::valid;
+    if (!repairs.values || repairs.species != species)
+        return Status::invalid_composition;
+    // Validate every prospective mass entry before mutating any fraction.
+    // Refuse an unrepresentable audit delta instead of silently dropping it.
+    for (int s = 0; s < species; ++s) {
+        const double x = fractions[s * stride];
+        if (x < 0.0) {
+            const double delta = (rho * -x) * cell_volume;
+            if (!std::isfinite(delta) || !(delta > 0.0))
+                return Status::invalid_composition;
+        }
+    }
+    repairs.event(cell_volume, cell);
+    for (int s = 0; s < species; ++s) {
+        const double x = fractions[s * stride];
+        if (x < 0.0) {
+            repairs.species_mass(s, (rho * -x) * cell_volume);
+            fractions[s * stride] = 0.0;
+        }
+    }
+    return Status::repaired;
+}
+
 ARCH_INLINE bool accepted(Status status)
 { return status == Status::valid || status == Status::repaired; }
 
