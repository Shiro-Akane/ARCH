# Periodic CGS gas box. Use the documented isolated and coupled variants.
geometry=cartesian
nblockx1=4
nblockx2=0
nblockx3=0
max_blocks=64
x1_min=0
x1_max=1e8
x1l_boundary_type=periodic
x1r_boundary_type=periodic
x2l_boundary_type=periodic
x2r_boundary_type=periodic
x3l_boundary_type=periodic
x3r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK3
cfl=0.2
lrefinemin=0
lrefinemax=0
regrid_interval=2
refine_var=DENS
refine_threshold=0.8
derefine_threshold=0.2
tmax=0.01
max_steps=-1
out_dir=output/gravity_box
base_name=GravityBox
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,ENER,ENUC
restart=false
eos_type=ideal
gamma=1.6666666666666667
gravity_type=self
gravity_boundary=periodic
use_burn=false
use_diffusion=false
rho0=1e7
temperature0=1e7
amplitude=1e-3
