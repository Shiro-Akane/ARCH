# Two-dimensional CGS C/O hotspot; run 120 coupled macro steps.
geometry=cartesian
nblockx1=1
nblockx2=1
nblockx3=0
max_blocks=16
x1_min=0
x1_max=1
x2_min=0
x2_max=1
x1l_boundary_type=periodic
x1r_boundary_type=periodic
x2l_boundary_type=periodic
x2r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.3
lrefinemin=0
lrefinemax=0
tmax=1e-7
max_steps=120
dt_init=2.5e-11
dt_min=1e-20
tstep_change_factor=1.0
out_dir=output/snia2d_coupled
base_name=SNIa2DCoupled
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,VELY,ENER,ENUC,SPECIES
restart=false
eos_type=helmholtz
eos_table_path=EOS_toolkit/tables/helmholtz/helm_table.dat
gravity_type=self
gravity_boundary=periodic
use_burn=true
network_name=aprox13
xhe4=0
xc12=0.5
xo16=0.5
nuclearTempMin=8e8
use_nse=false
ode_solver=bd
linear_solver=DenseLU
use_diffusion=true
use_thermal_diff=true
diff_integrator=RKL2
rho0=1e7
temperature0=1e9
temperature_peak=3e9
density_amplitude=0.01
hotspot_width=0.15
center_x=0.5
center_y=0.5
