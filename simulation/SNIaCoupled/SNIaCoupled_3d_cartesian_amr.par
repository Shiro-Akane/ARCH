# 3D Cartesian C/O hotspot with isolated gravity and AMR.
geometry=cartesian
nblockx1=2
nblockx2=1
nblockx3=1
max_blocks=128
x1_min=0
x1_max=1
x2_min=0
x2_max=1
x1l_boundary_type=outflow
x1r_boundary_type=outflow
x2l_boundary_type=outflow
x2r_boundary_type=outflow
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.3
lrefinemin=0
lrefinemax=1
tmax=1e-7
max_steps=5
dt_init=2.5e-11
dt_min=1e-20
tstep_change_factor=1.0
out_dir=output/snia_coupled_3d_cartesian_amr
base_name=SNIaCoupled3DCartAMR
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,VELY,ENER,ENUC,SPECIES
restart=false
eos_type=helmholtz
eos_table_path=EOS_toolkit/tables/helmholtz/helm_table.dat
gravity_type=self
gravity_boundary=isolated
use_burn=true
network_name=aprox13
xhe4=0
xc12=0.5
xo16=0.5
nuclearTempMin=8e8
use_nse=false
ode_solver=bd
linear_solver=DenseLU
use_diffusion=true
use_thermal_diff=true
diff_integrator=RKL2
rho0=1e7
temperature0=1e9
temperature_peak=3e9
density_amplitude=0.05
hotspot_width=0.1
center_x=0.25
center_y=0.5
regrid_interval=2
refine_var=DENS
refine_threshold=0.02
derefine_threshold=0.001
gravity_rtol=1e-08
x3_min=0
x3_max=1
x3l_boundary_type=outflow
x3r_boundary_type=outflow
center_z=0.25
