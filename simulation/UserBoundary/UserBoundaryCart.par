# One-dimensional Cartesian slab for the UserBoundary example.
# It is a boundary-callback smoke input, not a quantitative validation case.
# Both x1 faces use the registered physical callback and the gravity field uses
# the registered potential callback; thermal diffusion exercises the
# temperature channel of the same physical callback.

geometry = cartesian

nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 16

x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0

x1l_boundary_type = user
x1r_boundary_type = user
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
dt_init = 1.0e-6

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 1.0e-3
max_steps = -1
out_dir = output/user_boundary
base_name = UserBoundaryCart
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = -1
plt_variables = DENS, PRES, VELX, ENER
restart = false

eos_type = ideal
gamma = 1.4
use_burn = false

gravity_type = self
gravity_boundary = user

use_diffusion = true
diff_integrator = RKL2
diff_cfl = 0.8
use_thermal_diff = true
use_viscous_diff = false
use_species_diff = false
alpha_therm = 1.0e-2

# Optional documented boundary channel in erg/(cm^2 s): zero keeps the interior
# temperature as a Value condition, any nonzero value imposes that outward heat
# flux on the diffusion faces.
user_boundary_heat_flux = 0.0
