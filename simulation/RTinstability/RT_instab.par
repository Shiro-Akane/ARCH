# ==============================================================================
# ARCH Simulation Configuration File
# Case: Rayleigh-Taylor Instability (2D/3D Benchmark)
# ==============================================================================

# ------------------------------------------------------------------------------
# [Grid Configuration]
# Standard domain: 0.25 x 1.0 (for 2D)
# ------------------------------------------------------------------------------
nx       = 256
ny       = 1024
nz       = 1       # Change to 64 for full 3D simulation

x_min    = 0.0
x_max    = 0.25
y_min    = 0.0
y_max    = 1.0
z_min    = 0.0
z_max    = 0.25    # Only effectively used if nz > 1

geometry = cartesian 

# Standard RT boundary conditions: 
# Reflecting (solid walls) on top/bottom, Reflecting/Periodic on sides.
xr_boundary_type = reflect
xl_boundary_type = reflect
yr_boundary_type = reflect
yl_boundary_type = reflect
zr_boundary_type = reflect
zl_boundary_type = reflect

# ------------------------------------------------------------------------------
# [Numerics]
# ------------------------------------------------------------------------------
solver          = HLLC       # Options: SW, VL, Roe, HLL, HLLC
reconstruct     = ppm        # Options: pcm (1st), MUSCL (2nd), ppm(3rd)
time_integrator = RK3        # Options: RK2, RK3, Euler/RK1
limiter         = none       # Options: minmod, superbee, vanleer, mc, none
cfl             = 0.4        # Keep lower (<0.5) for multi-D instability tracking

EntropyFix = On
EntropyFixCoefficient = 0.1

# ------------------------------------------------------------------------------
# [Time & IO]
# Typical RT timescale sees full mushroom development around t = 8.5
# ------------------------------------------------------------------------------
tmax         = 8.5
max_steps    = -1        
restart      = false
restart_file = output/RT_instab_chk_0007.h5     

out_dir      = output
base_name    = RT_instab 

plt_dt       = 0.5      # Frequent output to render animations
plt_dstep    = -1        
plt_variables= all       # Ensures we output the "species" variable to see mixing

chk_dt       = 1.0      
chk_dstep    = -1        

# ------------------------------------------------------------------------------
# [Physics Core]
# ------------------------------------------------------------------------------
eos_type   = ideal # Options: ideal, tabular
eos_table_path = ""
gamma = 1.4    

gravity_type = external  
gravity_g_y  = -0.1      # Standard RT dimensionless gravity

# ------------------------------------------------------------------------------
# [Nuclear Burn & ODE]
# Maps to config.physics.burn.*
# ------------------------------------------------------------------------------
use_burn         = 0             # 0 = Off, 1 = On (Master switch for burning)
network_name     = aprox19       # Options: aprox19, custom, c12_o16
burn_verbose_level = 0           # 0 = Silent, 1 = Divergence Warnings, 2 = Full Step Info

# --- Physical Thresholds & Enforcers ---
nuclearTempMin   = 1e9           # 触发核燃烧的最小温度阈值 (K) (推荐范围: 5e8 ~ 1e9)
nuclearDensMin   = 1e-10         # 触发核燃烧的最小密度阈值 (g/cm^3)
small_temp       = 1e5           # Temperature floor for safety clipping
small_x          = 1e-20         # Mass fraction floor to prevent negative abundances
enforce_mass_conservation = 1    # 1 = Force sum(X_i) = 1.0 after each NR iteration

# --- Time Step Controls ---
dt_init          = 1e-16         # 极度刚性问题起爆时的强制初始时间步长 (推荐范围: 1e-16 ~ 1e-12)
dt_min           = 1e-20         # 隐式 ODE 求解器允许切分的最小物理步长 (推荐: 1e-22 ~ 1e-20)
tstep_change_factor = 1.2        # 宏观流体步长的最大增长率，避免能量爆发引发数值真空 (推荐: 1.1 ~ 1.2)
enucDtFactor     = 0.1           # 核能限制器：限制单步释放的核能比例 (推荐: 0.1)。代码内部具备自动探测机制：当处于粗网格(Sub-grid)欠分辨激波爆轰时，会自动限制缩步下限以防止锁死。

# --- ODE Integrator Settings ---
ode_solver       = BE_NR         # Options: BE_NR, ROS4, VODE (推荐极端刚性网络用 BE_NR)
linear_solver    = DenseLU       # Options: DenseLU, SparseWrap

# ------------------------------------------------------------------------------
# [User Custom Parameters (Read by RT_instab.cpp)]
# ------------------------------------------------------------------------------
rho_heavy = 2.0
rho_light = 1.0
y_int     = 0.5
p_int     = 2.5
amplitude = 0.025        # Perturbation velocity amplitude