# Minimal one-dimensional Sod problem for the README and CaseGuide.
# It is a teaching/smoke input, not a quantitative validation baseline.

geometry = cartesian

nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 16

x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0

x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 0.15
max_steps = -1
out_dir = output/first_sod
base_name = SodBeginner
plt_dt = 0.05
plt_dstep = -1
chk_dt = -1.0
chk_dstep = -1
plt_variables = DENS, PRES, VELX, ENER
restart = false

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = 0
use_diffusion = 0

x_pos = 0.5

rho_left = 1.0
p_left = 1.0
u_left = 0.0

rho_right = 0.125
p_right = 0.1
u_right = 0.0
