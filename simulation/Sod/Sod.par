# ==============================================================================
# ARCH Simulation Configuration File
# Case: Sod Shock Tube
# ==============================================================================

# ------------------------------------------------------------------------------
# [Grid Configuration]
# Maps to config.grid.*
# ------------------------------------------------------------------------------
n1       = 400
n2       = 400
n3       = 1

x1_min    = 0.0
x1_max    = 1.0
x2_min    = 0.0
x2_max    = 2.0 * pi
x3_min    = 0.0
x3_max    = 1.0

geometry = cylindrical # Options: cartesian, cylindrical, spherical

x1r_boundary_type = outflow # Options: reflect, outflow, periodic
x1l_boundary_type = outflow # Options: reflect, outflow, periodic
x2r_boundary_type = outflow
x2l_boundary_type = outflow
x3r_boundary_type = outflow
x3l_boundary_type = outflow

# ------------------------------------------------------------------------------
# [Numerics]
# Maps to config.numerics.*
# ------------------------------------------------------------------------------
solver      = HLLC       # Options: SW, VL, Roe, HLL, HLLC
reconstruct = ppm     # Options: pcm (1st), MUSCL (2nd), ppm(3rd)
time_integrator = RK3   # Options: RK2, RK3, Euler/RK1
limiter     = none   # Options: minmod, superbee, vanleer, mc, none
cfl         = 0.8       # Keep < 0.5 for VL/HLLC

EntropyFix = Off
EntropyFixCoefficient = 0.1 # share same control logic for SW smoothing coeff.

# ------------------------------------------------------------------------------
# [Time & IO]
# Maps to config.io.*
# ------------------------------------------------------------------------------
tmax         = 0.3
max_steps    = 10000        # Maximum number of iterations (-1 for infinite)
restart      = false         # Options: false, true
restart_file  = output/SodTube_chk_0005.h5

out_dir      = output
base_name    = SodTube      # Base name for output files (e.g., SodTube_HLLC_plt_0001.h5)

plt_dt       = 0.10         # Output PLT based on physical time interval (-1.0 to disable)
plt_dstep    = -1           # Output PLT based on iteration steps (-1 to disable)
plt_variables= all          # Options: all, conserved, or specific e.g., "rho,p,u,species"

chk_dt       = 0.10         # Output CHK based on physical time interval (-1.0 to disable)
chk_dstep    = -1           # Output CHK based on iteration steps (-1 to disable)

# ------------------------------------------------------------------------------
# [Physics Core]
# Maps to config.physics.*
# ------------------------------------------------------------------------------
eos_type   = ideal                       # Options: ideal, tabular
eos_table_path =../../src/physics/eos/eos_table/ideal_gas_3d.h5
gamma = 1.4    # Default global gamma (will be overridden by species)

gravity_type = external     #Options: none, enternal, self
gravity_g_y  = -981



# ------------------------------------------------------------------------------
# [User Custom Parameters]
# These are read into config.custom_params and used by Sod.cpp
# ------------------------------------------------------------------------------
# --- Geometry & Shape Control ---
# shape_type: 0 = Planar (1D Shock), 1 = Corner (2D Quadrant), 2 = Circle
shape_type = 2

# shock_dir is ONLY used if shape_type = 0 (0=X, 1=Y, 2=Z)
shock_dir  = 0  

# Position of the interface (Corner vertex for shape_type=1)
x_pos      = 0.0
y_pos      = 0.0
radius     = 0.2  # ONLY used if shape_type = 2

# --- Left / Inner State (High Pressure Quadrant: x < 0.5 & y < 0.5) ---
rho_left   = 1.0
p_left     = 1.0
u_left     = 0.0
v_left     = 0.0
name_left  = Air
gamma_left = 1.4
cv_left    = 717.5

# --- Right / Outer State (Low Pressure Background) ---
rho_right   = 0.125
p_right     = 0.1
u_right     = 0.0
v_right     = 0.0
name_right  = Heuilm
gamma_right = 1.67
cv_right    = 3113.9