# ==============================================================================
# ARCH Simulation Configuration File
# Case: Pure Carbon Detonation (1D ZND)
# ==============================================================================

# ------------------------------------------------------------------------------
# [Grid Configuration]
# ------------------------------------------------------------------------------
nx       = 1000       # 1D 高分辨率以解析反应区 (Reaction Zone)
ny       = 1
nz       = 1

x_min    = 0.0
x_max    = 256.0       # 从 100 扩展至 256 (参考 flash.par)
y_min    = 0.0
y_max    = 25.6
z_min    = 0.0
z_max    = 1.0

geometry = cartesian

# 边界条件：左侧通常设置为反射边界以充当"刚性墙壁"支撑起爆，右侧自由流出
xl_boundary_type = reflect
xr_boundary_type = outflow
yl_boundary_type = outflow
yr_boundary_type = outflow
zl_boundary_type = outflow
zr_boundary_type = outflow

# ------------------------------------------------------------------------------
# [Numerics]
# ------------------------------------------------------------------------------
solver      = HLLC       # 激波捕捉推荐 HLLC 或 Roe
reconstruct = ppm        # 燃烧问题对数值耗散敏感，建议使用三阶 PPM
time_integrator = RK3
limiter     = mc
cfl         = 0.8        # 包含刚性源项时，CFL 尽量压低

EntropyFix = On
EntropyFixCoefficient = 0.1

sml_rho = 1e-2       # Density floor to prevent vacuum crashing (similar to FLASH's smlrho)
max_eint = 1e19      # Cap maximum specific internal energy to prevent sound speed / CFL crashes

# ------------------------------------------------------------------------------
# [Time & IO]
# ------------------------------------------------------------------------------
tmax         = 1.0e-5    # 物理时间极短 (根据爆轰波速调整)
max_steps    = 150
restart      = false

out_dir      = output
base_name    = CDet_1D

plt_dstep    = 1000       # 每 100 步输出一次文件
plt_variables= all
chk_dstep    = 1000

# ------------------------------------------------------------------------------
# [Physics Core]
# ------------------------------------------------------------------------------
eos_type = helmholtz         # Ideal, tabular, helmholtz
eos_table_path = EOS_toolkit/helm_table.dat

gravity_type = none

# ------------------------------------------------------------------------------
# [Nuclear Burn & ODE]
# ------------------------------------------------------------------------------
use_burn         = 1
# 支持在无需重新编译的情况下热切换网络，可选值: aprox13, aprox19, aprox21, iso7
network_name     = aprox19
# burn_verbose_level 控制燃烧求解器的调试输出详细程度：
# 0 = 静默模式（仅输出致命错误）
# 1 = 基础信息模式（输出网络加载和初始化成功的信息，适合常规运行监控）
# 2 = 详细调试模式（可能会输出每个刚性积分器子步的具体迭代信息，适用于排错）
burn_verbose_level = 1

nuclearTempMin   = 1e7       # 触发核燃烧的最小温度阈值 (K) (推荐范围: 5e8 ~ 1e9)
nuclearDensMin   = 1e-10     # 触发核燃烧的最小密度阈值 (g/cm^3)

dt_init          = 1e-16     # 极度刚性问题起爆时的强制初始时间步长 (推荐范围: 1e-16 ~ 1e-12)
dt_min           = 1e-20     # 隐式 ODE 求解器允许切分的最小物理步长 (推荐: 1e-22 ~ 1e-20)
tstep_change_factor = 1.2    # 宏观流体步长的最大增长率，避免能量爆发引发数值真空 (推荐: 1.1 ~ 1.2)
enucDtFactor     = 1e30      # 核能限制器：限制单步释放的核能比例。设置为 1e30 相当于关闭燃烧对时间步的限制。

ode_solver       = BD      # BE_NR, ROS4, BD
linear_solver    = DenseLU

# ------------------------------------------------------------------------------
# [User Custom Parameters: CellularDet]
# ------------------------------------------------------------------------------
shock_dir = 0            # 激波传播方向 (0=X, 1=Y, 2=Z)
radiusPerturb = 25.6     # 初始施加 Von Neumann 扰动（跳跃条件）的区域长度 (推荐: ~12.8-25.6，包围几个胞格尺度)

# --- Ambient State (未燃环境) ---
# 代表激波前方的未反应流体状态
rhoAmbient = 1.0e7       # 环境密度 (g/cm^3)
tempAmbient   = 2.0e8    # 环境温度 (K) (不能过高以防提前自燃)

# --- Von Neumann Spike State (冯·诺依曼尖峰态) ---
# 激波阵面扫过但核反应还未大量发生时的“冻结”热力学状态 (根据 CJ 爆轰理论计算得出)
rhoPerturb = 4.322e7     # 激波后极值密度 (g/cm^3)
tempPerturb   = 4.670e9  # 激波后极值温度 (K)
velxPerturb   = 1.011e9  # 激波波速或活塞驱动速度 (cm/s)

# --- 胞格微扰 (Cellular Perturbation) ---
# 用于在 2D/3D 下打破对称性从而激发真实的胞格爆轰结构
noiseAmplitude = 0.2     # 密度和压力的横向正弦微扰幅度，0 表示一维平面对称爆轰 (推荐: 0.1 ~ 0.2)

# --- Initial Composition (初始同位素组分) ---
# Pynucastro aprox19 默认顺序：
# N, H1, He3, He4, C12, N14, O16, Ne20, Mg24, Si28, S32, Ar36, Ca40, Ti44, Cr48, Fe52, Fe54, Ni56
xhe4 = 0.4               # 质量分数 (和需为 1.0)
xc12 = 0.6
xo16 = 0.0