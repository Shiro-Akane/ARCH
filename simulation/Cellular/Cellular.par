# ==============================================================================
# ARCH Simulation Configuration File
# Case: Pure Carbon Detonation (1D ZND)
# ==============================================================================

# ------------------------------------------------------------------------------
# [Grid Configuration]
# ------------------------------------------------------------------------------
nx       = 1000       # 1D 高分辨率以解析反应区 (Reaction Zone)
ny       = 1
nz       = 1

x_min    = 0.0
x_max    = 256.0       # 从 100 扩展至 256 (参考 flash.par)
y_min    = 0.0
y_max    = 1.0
z_min    = 0.0
z_max    = 1.0

geometry = cartesian

# 边界条件：左侧通常设置为反射边界以充当"刚性墙壁"支撑起爆，右侧自由流出
xl_boundary_type = reflect
xr_boundary_type = outflow
yl_boundary_type = outflow
yr_boundary_type = outflow
zl_boundary_type = outflow
zr_boundary_type = outflow

# ------------------------------------------------------------------------------
# [Numerics]
# ------------------------------------------------------------------------------
solver      = HLLC       # 激波捕捉推荐 HLLC 或 Roe
reconstruct = ppm        # 燃烧问题对数值耗散敏感，建议使用三阶 PPM
time_integrator = RK3
limiter     = mc
cfl         = 0.4        # 包含刚性源项时，CFL 尽量压低

EntropyFix = On
EntropyFixCoefficient = 0.1

# ------------------------------------------------------------------------------
# [Time & IO]
# ------------------------------------------------------------------------------
tmax         = 1.0e-5    # 物理时间极短 (根据爆轰波速调整)
max_steps    = 150
restart      = false

out_dir      = output
base_name    = CDet_1D

plt_dstep    = 1000       # 每 100 步输出一次文件
plt_variables= all
chk_dstep    = 1000

# ------------------------------------------------------------------------------
# [Physics Core]
# ------------------------------------------------------------------------------
eos_type = helmholtz         # Ideal, tabular, helmholtz
eos_table_path = EOS_toolkit/helm_table.dat

gravity_type = none

# ------------------------------------------------------------------------------
# [Nuclear Burn & ODE]
# ------------------------------------------------------------------------------
use_burn         = 1
network_name     = aprox19
burn_verbose_level = 1

burn_temp_min    = 1e6   # C12 燃烧点很高
burn_rho_min     = 1e6
small_temp       = 1e6
small_x          = 1e-20
enforce_mass_conservation = 1

ode_solver       = BE_NR
linear_solver    = DenseLU
ode_rtol         = 1e-4
ode_atol         = 1e-10
ode_max_newton_iter = 150

# ------------------------------------------------------------------------------
# [User Custom Parameters: CellularDet]
# ------------------------------------------------------------------------------
shock_dir = 0        # 0=X, 1=Y, 2=Z
distance  = 12.8     # (对应 flash.par 的 radiusPerturb = 12.8)

# --- Ambient State (未燃环境) ---
rho_ambient = 1.0e7
T_ambient   = 2.0e8

# --- Von Neumann Spike State (手动估算的 CJ 后激波状态) ---
rho_vn = 4.0e7
T_vn   = 3.5e9
u_vn   = 9.5e8

# --- 胞格微扰 ---
noiseAmplitude = 0.2

# --- Initial Composition ---
# Pynucastro aprox19 默认顺序：
# N, H1, He3, He4, C12, N14, O16, Ne20, Mg24, Si28, S32, Ar36, Ca40, Ti44, Cr48, Fe52, Fe54, Ni56
x_c12 = 0.5
x_o16 = 0.5

# --- PI Controller Feedback ---
ode_dt_hydro_fac = 10.0