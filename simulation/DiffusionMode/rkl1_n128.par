# Periodic cosine-mode species diffusion: RKL1, 128 cells.
geometry = cartesian
nblockx1 = 8
nblockx2 = 0
nblockx3 = 0
max_blocks = 16
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = periodic
x1r_boundary_type = periodic
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cpu

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 0.1
max_steps = -1
restart = false
out_dir = output/validation/diffusion/rkl1_n128
base_name = DiffusionMode
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = -1
plt_variables = DENS, PRES, VELX, tracer

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = 0

use_diffusion = 1
diff_integrator = RKL1
diff_cfl = 0.8
diff_max_stages = 256
use_thermal_diff = 0
use_viscous_diff = 0
use_species_diff = 1
D_spec = 0.01

rho0 = 1.0
pressure0 = 1.0
tracer_mean = 0.5
tracer_amplitude = 0.25
mode = 1
