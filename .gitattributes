*.h5 filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text
/EOS_toolkit/tables/**/*.tab filter=lfs diff=lfs merge=lfs -text

# Runtime text logs are immutable evidence, not scientific table assets.
# Keep their exact bytes in ordinary Git; retain LFS for the EOS tables above.
/validation/**/results/**/*_log.dat -filter diff merge -text -whitespace

# Preserve compiler/CTest/sanitizer output byte-for-byte (including vendor padding).
/validation/**/results/**/*.txt -whitespace -text
/validation/**/results/**/*.log -whitespace -text
