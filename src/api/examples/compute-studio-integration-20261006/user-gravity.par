# One-dimensional cylindrical radial input for the UserGravity example.
# It is a boundary-callback smoke input, not a quantitative validation case.
# The r=0 face stays a reflecting natural regularity face that Core skips; the
# outer radial face uses the registered physical callback and both potential
# faces use the registered free-function gravity callback.

geometry = cylindrical

nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 16

x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0

x1l_boundary_type = reflecting
x1r_boundary_type = user
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
dt_init = 1.0e-6

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 1.0e-3
max_steps = -1
out_dir = output/user_gravity
base_name = UserGravityCylinder
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = -1
plt_variables = DENS, PRES, VELX, ENER
restart = false

eos_type = ideal
gamma = 1.4
use_burn = false

gravity_type = self
gravity_boundary = user

use_diffusion = true
diff_integrator = RKL2
diff_cfl = 0.8
use_thermal_diff = true
use_viscous_diff = false
use_species_diff = false
alpha_therm = 1.0e-2

# Example-specific boundary amplitude q0 in erg/(cm^2 s): zero keeps the interior
# temperature as a Value condition. A nonzero value prescribes the outward heat
# flux q(t)=q0*(1+t/(1 s)) on diffusion faces; this is a case parameter.
user_boundary_heat_flux = 0.0

# Explicit v3 migration of the former effective controls; physics is unchanged.
compute_backend = cpu
sml_rho = 1e-12
min_eint = 1e-10
max_eint = 1e21
hll_wave_speed = roe
network_name = none
gravity_rtol = 1e-10
gravity_atol = 0
