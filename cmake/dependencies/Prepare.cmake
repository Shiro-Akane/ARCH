# Explicit preparation for the public Core/desktop presets. HighFive and KLU remain
# owned by Dependencies.cmake; this script prepares tools and an HDF5 installation.
cmake_minimum_required(VERSION 3.22)
set(arch_prepare_calling_path "$ENV{PATH}")
if(NOT ARCH_PROFILE MATCHES "^(linux|windows)-(core|desktop)(-with-cuda)?$")
    message(FATAL_ERROR "Select ARCH_PROFILE=<linux|windows>-<core|desktop>[-with-cuda], for example linux-desktop-with-cuda.")
endif()
if(ARCH_PROFILE MATCHES "-desktop")
    set(arch_prepare_desktop TRUE)
endif()
if((ARCH_PROFILE MATCHES "^windows-" AND NOT CMAKE_HOST_WIN32)
   OR (ARCH_PROFILE MATCHES "^linux-" AND NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux"))
    message(FATAL_ERROR "${ARCH_PROFILE} must be prepared and built on its native host.")
endif()
if(ARCH_PROFILE MATCHES "-with-cuda$")
    set(arch_prepare_cuda TRUE)
    if(CMAKE_VERSION VERSION_LESS 3.25.2)
        message(FATAL_ERROR "CUDA desktop profiles require CMake 3.25.2 or newer.")
    endif()
endif()
get_filename_component(arch_source "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(arch_profile_build "${arch_source}/build/${ARCH_PROFILE}")
set(arch_prepared_file "${arch_profile_build}/prepared-toolchain.cmake")
# Remember local overrides on repeat preparation. Explicit -D values take priority.
include("${arch_prepared_file}" OPTIONAL)
set(ARCH_DEPENDENCY_ROOT "${arch_source}/build/dependencies" CACHE PATH "Local dependency downloads and ABI-specific installs")
set(ARCH_UCRT_ROOT "C:/msys64/ucrt64" CACHE PATH "Native MSYS2 UCRT64 installation")
set(ARCH_PREPARE_JOBS 2 CACHE STRING "Parallel jobs for dependency builds")
option(ARCH_PREPARE_OFFLINE "Use only existing dependency sources and installations" OFF)
if(NOT ARCH_PREPARE_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "ARCH_PREPARE_JOBS must be a positive integer.")
endif()
get_filename_component(ARCH_DEPENDENCY_ROOT "${ARCH_DEPENDENCY_ROOT}" ABSOLUTE)

function(arch_prepare_program variable)
    find_program(${variable} NAMES ${ARGN} REQUIRED)
    if(NOT EXISTS "${${variable}}" OR IS_DIRECTORY "${${variable}}")
        message(FATAL_ERROR "${variable} must identify an installed native executable: ${${variable}}")
    endif()
    file(REAL_PATH "${${variable}}" program)
    set(${variable} "${program}" PARENT_SCOPE)
endfunction()

if(CMAKE_HOST_WIN32 AND NOT arch_prepare_cuda)
    foreach(tool C CXX RC)
        if(tool STREQUAL "C")
            set(name gcc)
        elseif(tool STREQUAL "CXX")
            set(name g++)
        else()
            set(name windres)
        endif()
        if(NOT DEFINED CMAKE_${tool}_COMPILER)
            set(CMAKE_${tool}_COMPILER "${ARCH_UCRT_ROOT}/bin/${name}.exe")
        endif()
    endforeach()
    list(PREPEND CMAKE_PROGRAM_PATH "${ARCH_UCRT_ROOT}/bin")
elseif(CMAKE_HOST_WIN32)
    if(NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "x64"
       OR NOT "$ENV{VCToolsVersion}" MATCHES "^14[.]44[.]")
        message(FATAL_ERROR "Open an x64 Visual Studio Developer terminal initialized with MSVC 14.44 (-vcvars_ver=14.44), then run preparation there.")
    endif()
endif()
if(CMAKE_HOST_WIN32 AND arch_prepare_cuda)
    arch_prepare_program(CMAKE_C_COMPILER cl.exe)
    arch_prepare_program(CMAKE_CXX_COMPILER cl.exe)
    arch_prepare_program(CMAKE_RC_COMPILER rc.exe)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" OUTPUT_VARIABLE msvc_version ERROR_VARIABLE msvc_error)
    if(NOT "${msvc_version}${msvc_error}" MATCHES "19[.]44[.]")
        message(FATAL_ERROR "The selected cl.exe must belong to MSVC 14.44: ${CMAKE_CXX_COMPILER}")
    endif()
elseif(arch_prepare_cuda)
    arch_prepare_program(CMAKE_C_COMPILER gcc-12 gcc cc)
    arch_prepare_program(CMAKE_CXX_COMPILER g++-12 g++ c++)
else()
    arch_prepare_program(CMAKE_C_COMPILER gcc cc)
    arch_prepare_program(CMAKE_CXX_COMPILER g++ c++)
    if(CMAKE_HOST_WIN32)
        arch_prepare_program(CMAKE_RC_COMPILER windres.exe)
        execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -dumpmachine RESULT_VARIABLE gcc_result
            OUTPUT_VARIABLE gcc_target OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT gcc_result EQUAL 0 OR NOT gcc_target STREQUAL "x86_64-w64-mingw32")
            message(FATAL_ERROR "Windows CPU profiles require the native x64 GCC/UCRT64 compiler; select ARCH_UCRT_ROOT.")
        endif()
    endif()
endif()
if(CMAKE_HOST_WIN32 AND NOT arch_prepare_cuda)
    get_filename_component(arch_ucrt_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    string(TOLOWER "${arch_ucrt_bin}" expected_bin)
    set(arch_ucrt_on_path FALSE)
    foreach(directory IN LISTS arch_prepare_calling_path)
        if(IS_DIRECTORY "${directory}")
            file(REAL_PATH "${directory}" actual_bin)
            string(TOLOWER "${actual_bin}" actual_bin)
            if(actual_bin STREQUAL expected_bin)
                set(arch_ucrt_on_path TRUE)
            endif()
        endif()
    endforeach()
    if(NOT arch_ucrt_on_path)
        message(FATAL_ERROR
            "Add ${arch_ucrt_bin} to this PowerShell terminal's PATH before all three build commands. "
            "For example: $env:Path = '${arch_ucrt_bin};' + $env:Path . "
            "Preparation cannot change its parent terminal environment.")
    endif()
endif()
arch_prepare_program(CMAKE_MAKE_PROGRAM ninja ninja.exe)
if(arch_prepare_desktop)
    arch_prepare_program(ARCH_STUDIO_NODE node node.exe)
    execute_process(COMMAND "${ARCH_STUDIO_NODE}" -p "process.versions.node.split('.')[0]+':'+process.platform+':'+process.arch"
        RESULT_VARIABLE node_result OUTPUT_VARIABLE node_identity OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(CMAKE_HOST_WIN32)
        set(node_platform win32)
    else()
        set(node_platform linux)
    endif()
    if(NOT node_result EQUAL 0 OR NOT node_identity MATCHES "^([0-9]+):${node_platform}:x64$" OR CMAKE_MATCH_1 LESS 24)
        message(FATAL_ERROR "Studio requires native x64 Node 24+. Set -DARCH_STUDIO_NODE=/absolute/path/to/node (found '${node_identity}').")
    endif()
    get_filename_component(arch_node_bin "${ARCH_STUDIO_NODE}" DIRECTORY)
    if(CMAKE_HOST_WIN32)
        if(NOT EXISTS "${arch_node_bin}/node_modules/npm/bin/npm-cli.js")
            message(FATAL_ERROR "Install npm alongside the selected Node: ${ARCH_STUDIO_NODE}")
        endif()
        find_program(ARCH_STUDIO_OBJDUMP NAMES objdump.exe HINTS "${ARCH_UCRT_ROOT}/bin" REQUIRED)
        arch_prepare_program(ARCH_STUDIO_OBJDUMP objdump.exe)
        execute_process(COMMAND "${ARCH_STUDIO_OBJDUMP}" --version RESULT_VARIABLE objdump_result
            OUTPUT_VARIABLE objdump_version)
        if(NOT objdump_result EQUAL 0 OR NOT objdump_version MATCHES "GNU objdump")
            message(FATAL_ERROR "Windows Studio requires GNU objdump; select ARCH_STUDIO_OBJDUMP.")
        endif()
    else()
        find_program(ARCH_STUDIO_NPM npm HINTS "${arch_node_bin}" REQUIRED)
    endif()
endif()
if(NOT ARCH_PREPARE_OFFLINE)
    find_program(GIT_EXECUTABLE NAMES git git.exe HINTS "$ENV{ProgramFiles}/Git/cmd" REQUIRED)
endif()

get_filename_component(arch_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
set(ARCH_PREPARED_RUNTIME_DIRS "${arch_compiler_bin}")
if(GIT_EXECUTABLE)
    get_filename_component(arch_git_bin "${GIT_EXECUTABLE}" DIRECTORY)
    list(APPEND ARCH_PREPARED_RUNTIME_DIRS "${arch_git_bin}")
endif()
if(ARCH_STUDIO_OBJDUMP)
    get_filename_component(arch_objdump_bin "${ARCH_STUDIO_OBJDUMP}" DIRECTORY)
    list(APPEND ARCH_PREPARED_RUNTIME_DIRS "${arch_objdump_bin}")
endif()
if(CMAKE_HOST_WIN32 AND NOT arch_prepare_cuda)
    list(APPEND ARCH_PREPARED_RUNTIME_DIRS "${ARCH_UCRT_ROOT}/bin")
endif()
if(arch_prepare_cuda)
    find_program(CMAKE_CUDA_COMPILER nvcc nvcc.exe
        HINTS "${CUDAToolkit_ROOT}/bin" "$ENV{CUDAToolkit_ROOT}/bin" "$ENV{CUDA_PATH}/bin" /usr/local/cuda/bin REQUIRED)
    arch_prepare_program(CMAKE_CUDA_COMPILER nvcc nvcc.exe)
    execute_process(COMMAND "${CMAKE_CUDA_COMPILER}" --version RESULT_VARIABLE cuda_result
        OUTPUT_VARIABLE cuda_version ERROR_VARIABLE cuda_error)
    if(NOT cuda_result EQUAL 0 OR NOT cuda_version MATCHES "release ([0-9]+)[.]([0-9]+)" OR CMAKE_MATCH_1 LESS 12)
        message(FATAL_ERROR "Install CUDA Toolkit 12+ and select its nvcc with CMAKE_CUDA_COMPILER: ${cuda_version}${cuda_error}")
    endif()
    get_filename_component(arch_cuda_bin "${CMAKE_CUDA_COMPILER}" DIRECTORY)
    get_filename_component(CUDAToolkit_ROOT "${arch_cuda_bin}" DIRECTORY)
    list(APPEND ARCH_PREPARED_RUNTIME_DIRS "${arch_cuda_bin}")
    if(NOT CMAKE_HOST_WIN32)
        set(CMAKE_CUDA_HOST_COMPILER "${CMAKE_CXX_COMPILER}")
    endif()
endif()
list(REMOVE_DUPLICATES ARCH_PREPARED_RUNTIME_DIRS)
if(CMAKE_HOST_WIN32)
    list(JOIN ARCH_PREPARED_RUNTIME_DIRS ";" arch_runtime_path)
    set(ENV{PATH} "${arch_runtime_path};$ENV{PATH}")
else()
    list(JOIN ARCH_PREPARED_RUNTIME_DIRS ":" arch_runtime_path)
    set(ENV{PATH} "${arch_runtime_path}:$ENV{PATH}")
endif()

# The compiler files and SDK version identify dependency builds, independently of
# the profile name. A changed compiler never reuses an incompatible build cache.
file(SHA256 "${CMAKE_C_COMPILER}" arch_c_hash)
file(SHA256 "${CMAKE_CXX_COMPILER}" arch_cxx_hash)
string(SHA256 arch_abi "${CMAKE_HOST_SYSTEM_NAME}|${CMAKE_C_COMPILER}|${arch_c_hash}|${CMAKE_CXX_COMPILER}|${arch_cxx_hash}|$ENV{VCToolsVersion}|$ENV{WindowsSDKVersion}")
string(SUBSTRING "${arch_abi}" 0 16 arch_abi_short)
set(arch_dependency_build "${ARCH_DEPENDENCY_ROOT}/${CMAKE_HOST_SYSTEM_NAME}-${arch_abi_short}")
if(EXISTS "${arch_profile_build}/CMakeCache.txt")
    foreach(language C CXX)
        file(STRINGS "${arch_profile_build}/CMakeCache.txt" existing_compiler REGEX "^CMAKE_${language}_COMPILER:[^=]+=")
        string(REGEX REPLACE "^[^=]*=" "" existing_compiler "${existing_compiler}")
        if(existing_compiler AND NOT existing_compiler STREQUAL CMAKE_${language}_COMPILER)
            message(FATAL_ERROR "${arch_profile_build} already uses a different ${language} compiler. Start with a fresh profile build directory before changing ABI.")
        endif()
    endforeach()
endif()
file(MAKE_DIRECTORY "${arch_profile_build}/prepare" "${arch_dependency_build}")
file(LOCK "${arch_dependency_build}/prepare.lock" GUARD PROCESS TIMEOUT 60)

# A cache initializer is shared by the tiny ABI probe and the HDF5 build. It is
# intentionally separate from the project toolchain, which is published last.
function(arch_prepare_cache_line output variable type)
    if(DEFINED ${variable})
        if("${${variable}}" MATCHES "\\]==\\]")
            message(FATAL_ERROR "Unsupported CMake delimiter in ${variable}.")
        endif()
        if(arch_publish_choices)
            set(force " \${arch_prepared_force}")
        endif()
        file(APPEND "${output}" "set(${variable} [==[${${variable}}]==] CACHE ${type} \"Prepared local selection\"${force})\n")
    endif()
endfunction()
set(arch_compiler_cache "${arch_profile_build}/prepare/compilers.cmake")
file(WRITE "${arch_compiler_cache}" "# Selected native tools for dependency preparation.\n")
foreach(variable CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_RC_COMPILER CMAKE_MAKE_PROGRAM)
    arch_prepare_cache_line("${arch_compiler_cache}" ${variable} FILEPATH)
endforeach()
file(APPEND "${arch_compiler_cache}" "set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING \"Pinned dependency CMake compatibility\")\n")
include("${CMAKE_CURRENT_LIST_DIR}/PrepareHdf5.cmake")
arch_prepare_hdf5()

# Preserve explicit FetchContent source overrides; do not maintain duplicate
# HighFive/KLU versions or populate their sources outside their existing owner.
if(ARCH_PREPARE_OFFLINE)
    foreach(dependency HIGHFIVE SUITESPARSE)
        if(NOT FETCHCONTENT_SOURCE_DIR_${dependency})
            string(TOLOWER "${dependency}" dependency_lower)
            if(EXISTS "${arch_profile_build}/_deps/${dependency_lower}-src/CMakeLists.txt")
                set(FETCHCONTENT_SOURCE_DIR_${dependency} "${arch_profile_build}/_deps/${dependency_lower}-src")
            elseif(dependency STREQUAL "HIGHFIVE" OR NOT KLU_DIR)
                message(FATAL_ERROR "Offline preparation needs -DFETCHCONTENT_SOURCE_DIR_${dependency}=/existing/source (or installed KLU for SuiteSparse).")
            endif()
        endif()
    endforeach()
    set(FETCHCONTENT_FULLY_DISCONNECTED ON)
else()
    set(FETCHCONTENT_FULLY_DISCONNECTED OFF)
endif()
foreach(dependency HIGHFIVE SUITESPARSE)
    if(FETCHCONTENT_SOURCE_DIR_${dependency} AND NOT EXISTS "${FETCHCONTENT_SOURCE_DIR_${dependency}}/CMakeLists.txt")
        message(FATAL_ERROR "FETCHCONTENT_SOURCE_DIR_${dependency} must identify an existing source tree.")
    endif()
endforeach()
set(ARCH_PREPARED_C_COMPILER "${CMAKE_C_COMPILER}")
set(ARCH_PREPARED_CXX_COMPILER "${CMAKE_CXX_COMPILER}")
set(arch_next_file "${arch_prepared_file}.tmp")
file(WRITE "${arch_next_file}" "# Machine-local selections; regenerate with cmake -DARCH_PROFILE=${ARCH_PROFILE} -P cmake/dependencies/Prepare.cmake.\n")
file(APPEND "${arch_next_file}" "set(arch_prepared_force FORCE)\nif(CMAKE_SCRIPT_MODE_FILE)\n    set(arch_prepared_force \"\")\nendif()\n")
foreach(language C CXX CUDA)
    if(CMAKE_${language}_COMPILER)
        file(APPEND "${arch_next_file}" "if(NOT CMAKE_SCRIPT_MODE_FILE AND DEFINED CMAKE_${language}_COMPILER AND NOT CMAKE_${language}_COMPILER STREQUAL [==[${CMAKE_${language}_COMPILER}]==])\n    message(FATAL_ERROR \"Compiler differs from prepared ${ARCH_PROFILE}; pass overrides to Prepare.cmake and use a fresh build directory.\")\nendif()\n")
    endif()
endforeach()
set(arch_publish_choices TRUE)
foreach(variable CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_RC_COMPILER CMAKE_CUDA_COMPILER CMAKE_CUDA_HOST_COMPILER
        CMAKE_MAKE_PROGRAM GIT_EXECUTABLE ARCH_STUDIO_NODE ARCH_STUDIO_NPM ARCH_STUDIO_OBJDUMP)
    arch_prepare_cache_line("${arch_next_file}" ${variable} FILEPATH)
endforeach()
foreach(variable ARCH_UCRT_ROOT ARCH_DEPENDENCY_ROOT ARCH_HDF5_SOURCE_DIR ARCH_ZLIB_ARCHIVE
        HDF5_ROOT HDF5_DIR KLU_DIR CUDAToolkit_ROOT CUDSS_ROOT FETCHCONTENT_SOURCE_DIR_HIGHFIVE FETCHCONTENT_SOURCE_DIR_SUITESPARSE)
    arch_prepare_cache_line("${arch_next_file}" ${variable} PATH)
endforeach()
foreach(variable CMAKE_PREFIX_PATH ARCH_PREPARED_RUNTIME_DIRS ARCH_PREPARED_C_COMPILER ARCH_PREPARED_CXX_COMPILER)
    arch_prepare_cache_line("${arch_next_file}" ${variable} STRING)
endforeach()
arch_prepare_cache_line("${arch_next_file}" FETCHCONTENT_FULLY_DISCONNECTED BOOL)
file(APPEND "${arch_next_file}" "set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING \"Pinned dependency CMake compatibility\")\n")
if(CMAKE_HOST_WIN32)
    file(APPEND "${arch_next_file}" [=[
set(arch_prepared_path ${ARCH_PREPARED_RUNTIME_DIRS} $ENV{PATH})
list(REMOVE_DUPLICATES arch_prepared_path)
list(JOIN arch_prepared_path ";" arch_prepared_path)
set(ENV{PATH} "${arch_prepared_path}")
]=])
endif()
# Keep the timestamp unchanged when preparation selects the same values.
configure_file("${arch_next_file}" "${arch_prepared_file}" COPYONLY)
file(REMOVE "${arch_next_file}")
message(STATUS "Prepared ${ARCH_PROFILE}. Configure: cmake --preset ${ARCH_PROFILE}")
message(STATUS "Then build: cmake --build --preset ${ARCH_PROFILE}")
