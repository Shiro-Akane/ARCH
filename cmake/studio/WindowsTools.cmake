# Build-local native tools. This manifest is consumed only by Electron Main;
# portable packages never contain the configured machine paths.
function(arch_studio_json_string output value)
    string(REPLACE "\\" "/" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

if(CMAKE_GENERATOR MATCHES "^Ninja")
    set(studio_ninja "${CMAKE_MAKE_PROGRAM}")
else()
    find_program(ARCH_STUDIO_NINJA NAMES ninja.exe ninja REQUIRED)
    set(studio_ninja "${ARCH_STUDIO_NINJA}")
endif()
# The Host reads GNU-compatible `objdump -p -- file` import tables. MSVC's
# dumpbin is not interchangeable with this interface.
if(ARCH_STUDIO_OBJDUMP)
    set(studio_objdump "${ARCH_STUDIO_OBJDUMP}")
elseif(CMAKE_OBJDUMP MATCHES "(^|[/\\\\])([^/\\\\]*-)?objdump(\\.exe)?$"
        AND NOT CMAKE_OBJDUMP MATCHES "(^|[/\\\\])llvm-objdump(\\.exe)?$")
    set(studio_objdump "${CMAKE_OBJDUMP}")
else()
    find_program(ARCH_STUDIO_OBJDUMP NAMES objdump.exe objdump
        HINTS "${ARCH_UCRT_ROOT}/bin" REQUIRED)
    set(studio_objdump "${ARCH_STUDIO_OBJDUMP}")
endif()
get_filename_component(studio_objdump_name "${studio_objdump}" NAME)
string(TOLOWER "${studio_objdump_name}" studio_objdump_name)
if(studio_objdump_name MATCHES "^(dumpbin|llvm-objdump)(\\.exe)?$")
    message(FATAL_ERROR "Studio requires GNU-compatible objdump output; dumpbin and llvm-objdump use different inspection formats.")
endif()
set(studio_cmake "${CMAKE_COMMAND}")
set(studio_supervisor "$<TARGET_FILE:arch_windows_process>")
set(studio_publisher "$<TARGET_FILE:arch_windows_build_publish>")
set(studio_rc "${CMAKE_RC_COMPILER}")
if(NOT EXISTS "${studio_rc}")
    message(FATAL_ERROR "Studio requires the selected native Windows resource compiler (CMAKE_RC_COMPILER).")
endif()

# Core owns the dependency/compiler runtime directories and DLL requirements.
set(studio_runtime_dirs "${arch_windows_runtime_dirs}")
foreach(program IN ITEMS "${studio_ninja}" "${studio_objdump}" "${ARCH_STUDIO_NODE}")
    get_filename_component(directory "${program}" DIRECTORY)
    list(APPEND studio_runtime_dirs "${directory}")
endforeach()
list(APPEND studio_runtime_dirs "$<TARGET_FILE_DIR:arch_windows_process>"
    "$<TARGET_FILE_DIR:arch_windows_build_publish>")
list(REMOVE_DUPLICATES studio_runtime_dirs)
list(JOIN studio_runtime_dirs ";" studio_path_native)
set(studio_json "{")
foreach(key IN ITEMS cmake supervisor ninja objdump publisher rc)
    arch_studio_json_string(value "${studio_${key}}")
    string(APPEND studio_json "\"${key}\":${value},")
endforeach()
arch_studio_json_string(value "${studio_path_native}")
string(APPEND studio_json "\"path\":${value},\"compilerEnvironment\":{")
set(separator "")
foreach(key IN ITEMS INCLUDE LIB LIBPATH)
    if(NOT "${arch_windows_compiler_${key}}" STREQUAL "")
        arch_studio_json_string(value "${arch_windows_compiler_${key}}")
        string(APPEND studio_json "${separator}\"${key}\":${value}")
        set(separator ",")
    endif()
endforeach()
string(APPEND studio_json "},\"runtimeLibraries\":[")
set(separator "")
foreach(library IN LISTS arch_windows_runtime_libraries)
    arch_studio_json_string(value "${library}")
    string(APPEND studio_json "${separator}${value}")
    set(separator ",")
endforeach()
string(APPEND studio_json "]}\n")
set(ARCH_STUDIO_WINDOWS_TOOLS_FILE "${CMAKE_BINARY_DIR}/studio/windows-tools.json")
file(GENERATE OUTPUT "${ARCH_STUDIO_WINDOWS_TOOLS_FILE}" CONTENT "${studio_json}")
