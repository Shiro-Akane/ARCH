# Build-local native tools. This manifest is consumed only by Electron Main;
# portable packages never contain the configured machine paths.
function(arch_studio_json_string output value)
    string(REPLACE "\\" "/" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

if(CMAKE_GENERATOR MATCHES "^Ninja")
    set(studio_ninja "${CMAKE_MAKE_PROGRAM}")
else()
    find_program(ARCH_STUDIO_NINJA NAMES ninja.exe ninja REQUIRED)
    set(studio_ninja "${ARCH_STUDIO_NINJA}")
endif()
# The Host reads GNU-compatible `objdump -p -- file` import tables. MSVC's
# dumpbin is not interchangeable with this interface.
if(CMAKE_OBJDUMP MATCHES "(^|[/\\\\])([^/\\\\]*-)?objdump(\\.exe)?$")
    set(studio_objdump "${CMAKE_OBJDUMP}")
else()
    find_program(ARCH_STUDIO_OBJDUMP NAMES objdump.exe objdump
        HINTS "${ARCH_UCRT_ROOT}/bin" REQUIRED)
    set(studio_objdump "${ARCH_STUDIO_OBJDUMP}")
endif()
set(studio_cmake "${CMAKE_COMMAND}")
set(studio_supervisor "$<TARGET_FILE:arch_windows_process>")
set(studio_publisher "$<TARGET_FILE:arch_windows_build_publish>")
set(studio_rc "${CMAKE_RC_COMPILER}")
if(NOT EXISTS "${studio_rc}")
    message(FATAL_ERROR "Studio requires the selected native Windows resource compiler (CMAKE_RC_COMPILER).")
endif()

set(studio_runtime_dirs "${ARCH_PREPARED_RUNTIME_DIRS}")
foreach(program IN ITEMS "${CMAKE_COMMAND}" "${studio_ninja}" "${studio_objdump}"
        "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${CMAKE_CUDA_COMPILER}"
        "${CMAKE_RC_COMPILER}" "${ARCH_STUDIO_NODE}")
    if(program)
        get_filename_component(directory "${program}" DIRECTORY)
        list(APPEND studio_runtime_dirs "${directory}")
    endif()
endforeach()
list(APPEND studio_runtime_dirs "$<TARGET_FILE_DIR:ARCH>"
    "$<TARGET_FILE_DIR:arch_windows_process>" "$<TARGET_FILE_DIR:arch_windows_build_publish>")
file(TO_CMAKE_PATH "$ENV{SystemRoot}" studio_system_root)
if(NOT studio_system_root)
    message(FATAL_ERROR "Native Windows Studio requires SystemRoot in the configure environment.")
endif()
list(APPEND studio_runtime_dirs "${studio_system_root}/System32" "${studio_system_root}")

# Only libraries selected by the linked optional provider are prerequisites.
set(studio_runtime_libraries "")
if(ARCH_ENABLE_CUDA AND ARCH_ENABLE_CUDSS AND CuDSS_FOUND)
    foreach(library IN ITEMS CuDSS_RUNTIME_LIBRARY CUDA_cublas_RUNTIME_LIBRARY CUDA_cublasLt_RUNTIME_LIBRARY)
        if(NOT EXISTS "${${library}}")
            message(FATAL_ERROR "Linked cuDSS requires its native runtime DLL: ${library}=${${library}}")
        endif()
        list(APPEND studio_runtime_libraries "${${library}}")
        get_filename_component(directory "${${library}}" DIRECTORY)
        list(APPEND studio_runtime_dirs "${directory}")
    endforeach()
endif()
list(REMOVE_DUPLICATES studio_runtime_dirs)
list(JOIN studio_runtime_dirs ";" studio_path_native)
set(studio_json "{")
foreach(key IN ITEMS cmake supervisor ninja objdump publisher rc)
    arch_studio_json_string(value "${studio_${key}}")
    string(APPEND studio_json "\"${key}\":${value},")
endforeach()
arch_studio_json_string(value "${studio_path_native}")
string(APPEND studio_json "\"path\":${value},\"compilerEnvironment\":{")
set(studio_environment_lines "")
set(separator "")
foreach(key IN ITEMS INCLUDE LIB LIBPATH)
    if(NOT "$ENV{${key}}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{${key}}" directories)
        foreach(directory IN LISTS directories)
            if(NOT IS_ABSOLUTE "${directory}" OR NOT IS_DIRECTORY "${directory}")
                message(FATAL_ERROR "Studio ${key} contains an unavailable absolute directory: ${directory}")
            endif()
        endforeach()
        arch_studio_json_string(value "${directories}")
        string(APPEND studio_json "${separator}\"${key}\":${value}")
        set(separator ",")
        string(REPLACE "%" "%%" directories "${directories}")
        string(APPEND studio_environment_lines "set \"${key}=${directories}\"\n")
    endif()
endforeach()
string(APPEND studio_json "},\"runtimeLibraries\":[")
set(studio_runtime_checks "")
set(separator "")
foreach(library IN LISTS studio_runtime_libraries)
    arch_studio_json_string(value "${library}")
    string(APPEND studio_json "${separator}${value}")
    set(separator ",")
    string(REPLACE "%" "%%" library "${library}")
    string(APPEND studio_runtime_checks "if not exist \"${library}\" (\n  >&2 echo Required Windows runtime DLL is unavailable: \"${library}\"\n  exit /b 1\n)\n")
endforeach()
string(APPEND studio_json "]}\n")
set(ARCH_STUDIO_WINDOWS_TOOLS_FILE "${CMAKE_BINARY_DIR}/studio/windows-tools.json")
file(GENERATE OUTPUT "${ARCH_STUDIO_WINDOWS_TOOLS_FILE}" CONTENT "${studio_json}")

# CLI and Studio consume the same directories; CLI callers can `call` this file
# before ARCH.exe without requiring Node or a second dependency-discovery path.
string(REPLACE "%" "%%" studio_path_native "${studio_path_native}")
file(GENERATE OUTPUT "${ARCH_RUNTIME_OUTPUT_DIRECTORY}/arch-env.cmd"
    CONTENT "@echo off\n${studio_runtime_checks}set \"PATH=${studio_path_native}\"\n${studio_environment_lines}exit /b 0\n"
    NEWLINE_STYLE CRLF)
