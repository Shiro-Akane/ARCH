# Shared native runtime setup for Core CLI and Studio; no Node or PE inspector
# is needed to configure or launch a Core-only build.
if(NOT WIN32)
    return()
endif()

set(arch_windows_runtime_dirs "${ARCH_PREPARED_RUNTIME_DIRS}")
# A manually configured Core tree has no prepared manifest. Reuse the libraries
# already selected by find_package rather than searching for another installation.
set(arch_windows_hdf_artifacts "")
string(TOUPPER "${CMAKE_BUILD_TYPE}" arch_windows_configuration)
foreach(library IN LISTS HDF5_LIBRARIES HDF5_CXX_LIBRARIES HDF5_HL_LIBRARIES)
    if(TARGET "${library}")
        foreach(property IN ITEMS IMPORTED_LOCATION_${arch_windows_configuration}
                IMPORTED_LOCATION IMPORTED_LOCATION_NOCONFIG
                IMPORTED_IMPLIB_${arch_windows_configuration} IMPORTED_IMPLIB IMPORTED_IMPLIB_NOCONFIG)
            get_target_property(artifact "${library}" "${property}")
            if(artifact)
                list(APPEND arch_windows_hdf_artifacts "${artifact}")
            endif()
        endforeach()
    elseif(IS_ABSOLUTE "${library}")
        list(APPEND arch_windows_hdf_artifacts "${library}")
    endif()
endforeach()
set(arch_windows_dependency_dirs "")
foreach(artifact IN LISTS arch_windows_hdf_artifacts)
    get_filename_component(directory "${artifact}" DIRECTORY)
    list(APPEND arch_windows_dependency_dirs "${directory}" "${directory}/../bin")
endforeach()
foreach(prefix IN ITEMS "${HDF5_ROOT}" ${CMAKE_PREFIX_PATH})
    if(prefix)
        list(APPEND arch_windows_dependency_dirs "${prefix}/bin")
    endif()
endforeach()
if(MSVC AND ARCH_ENABLE_OPENMP AND NOT "$ENV{VCToolsRedistDir}" STREQUAL "")
    file(GLOB arch_windows_openmp_libraries
        "$ENV{VCToolsRedistDir}/debug_nonredist/x64/Microsoft.VC*.OpenMP.LLVM/libomp140.x86_64.dll")
    foreach(library IN LISTS arch_windows_openmp_libraries)
        get_filename_component(directory "${library}" DIRECTORY)
        list(APPEND arch_windows_dependency_dirs "${directory}")
    endforeach()
endif()
foreach(directory IN LISTS arch_windows_dependency_dirs)
    if(IS_DIRECTORY "${directory}")
        file(REAL_PATH "${directory}" directory)
        list(APPEND arch_windows_runtime_dirs "${directory}")
    endif()
endforeach()
foreach(program IN ITEMS "${CMAKE_COMMAND}" "${CMAKE_MAKE_PROGRAM}"
        "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${CMAKE_CUDA_COMPILER}"
        "${CMAKE_RC_COMPILER}")
    if(program)
        get_filename_component(directory "${program}" DIRECTORY)
        list(APPEND arch_windows_runtime_dirs "${directory}")
    endif()
endforeach()
list(APPEND arch_windows_runtime_dirs "$<TARGET_FILE_DIR:ARCH>")
file(TO_CMAKE_PATH "$ENV{SystemRoot}" arch_windows_system_root)
if(NOT arch_windows_system_root)
    message(FATAL_ERROR "Native Windows runtime setup requires SystemRoot in the configure environment.")
endif()
list(APPEND arch_windows_runtime_dirs "${arch_windows_system_root}/System32" "${arch_windows_system_root}")

# Only libraries selected by the linked optional provider are prerequisites.
set(arch_windows_runtime_libraries "")
if(ARCH_ENABLE_CUDA AND ARCH_ENABLE_CUDSS AND CuDSS_FOUND)
    foreach(library IN ITEMS CuDSS_RUNTIME_LIBRARY CUDA_cublas_RUNTIME_LIBRARY CUDA_cublasLt_RUNTIME_LIBRARY)
        if(NOT EXISTS "${${library}}")
            message(FATAL_ERROR "Linked cuDSS requires its native runtime DLL: ${library}=${${library}}")
        endif()
        list(APPEND arch_windows_runtime_libraries "${${library}}")
        get_filename_component(directory "${${library}}" DIRECTORY)
        list(APPEND arch_windows_runtime_dirs "${directory}")
    endforeach()
endif()
list(REMOVE_DUPLICATES arch_windows_runtime_dirs)
list(JOIN arch_windows_runtime_dirs ";" arch_windows_runtime_path)

set(arch_windows_environment_lines "")
foreach(key IN ITEMS INCLUDE LIB LIBPATH)
    set(arch_windows_compiler_${key} "")
    if(NOT "$ENV{${key}}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{${key}}" directories)
        foreach(directory IN LISTS directories)
            if(NOT IS_ABSOLUTE "${directory}" OR NOT IS_DIRECTORY "${directory}")
                message(FATAL_ERROR "Windows ${key} contains an unavailable absolute directory: ${directory}")
            endif()
        endforeach()
        set(arch_windows_compiler_${key} "${directories}")
        string(REPLACE "%" "%%" directories "${directories}")
        string(APPEND arch_windows_environment_lines "set \"${key}=${directories}\"\n")
    endif()
endforeach()
set(arch_windows_runtime_checks "")
foreach(library IN LISTS arch_windows_runtime_libraries)
    string(REPLACE "%" "%%" library "${library}")
    string(APPEND arch_windows_runtime_checks "if not exist \"${library}\" (\n  >&2 echo Required Windows runtime DLL is unavailable: \"${library}\"\n  exit /b 1\n)\n")
endforeach()
# `call arch-env.cmd` sets the same dependency directories consumed by Studio.
string(REPLACE "%" "%%" arch_windows_runtime_path "${arch_windows_runtime_path}")
file(GENERATE OUTPUT "${ARCH_RUNTIME_OUTPUT_DIRECTORY}/arch-env.cmd"
    CONTENT "@echo off\n${arch_windows_runtime_checks}set \"PATH=${arch_windows_runtime_path}\"\n${arch_windows_environment_lines}exit /b 0\n"
    NEWLINE_STYLE CRLF)
