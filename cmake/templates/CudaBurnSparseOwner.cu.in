/**
 * @file CudaBurnSparseOwner.cu.in
 * @brief Bind one network/EOS pair to the CUDA sparse-burn storage owner.
 *
 * CudaBurnSparseRoutes.cmake supplies this specialization's types. The shared
 * factory constructs workspace and continuation state for the selected route;
 * numerical formulas remain in the common network, EOS and ODE headers.
 */
#include "@ARCH_SPARSE_EOS_HEADER@"
#include "cuda/runtime/burn/CudaBackendBurnSparseRoutes.h"
#include "@ARCH_SPARSE_NETWORK_HEADER@"
#include "cuda/runtime/burn/CudaBackendBurnSparseImpl.cuh"

namespace arch::cuda::burn_detail {
template<>
std::unique_ptr<CudaSparseBurnOwner>
make_sparse_burn_owner_route<dispatch::@ARCH_SPARSE_BINDING@, @ARCH_SPARSE_EOS@>(
    const dispatch::ResolvedExecutionPlan& plan, @ARCH_SPARSE_EOS@ eos,
    int max_cells, cudaStream_t stream)
{
    using Network = @ARCH_SPARSE_NETWORK_TYPE@;
    return make_sparse_burn_owner_for_network<Network>(plan, eos, max_cells, stream);
}
} // namespace arch::cuda::burn_detail
