# Native r-z axial first-mode benchmark; physical momentum slots are r,z,phi.
# Uniform root averages and the original unit-period analytic endpoint apply.
# Smooth periodic entropy-wave advection: PCM, 64 cells.
# VALIDATION INPUT: current canonical template owned by validation/hydro/README.md; see its provenance note for the historical snapshot identity.
geometry = cylindrical
nblockx1 = 1
nblockx2 = 4
nblockx3 = 0
max_blocks = 24
x1_min = 1.0
x1_max = 2.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = reflect
x1r_boundary_type = reflect
x2l_boundary_type = periodic
x2r_boundary_type = periodic
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
# HLL/HLLC signal-speed estimator: roe (Roe-Glaister acoustic); explicit, no default is restored.
hll_wave_speed = roe
reconstruct = pcm
limiter = mc
time_integrator = RK3
cfl = 0.3
sml_rho = 1e-12
max_eint = 1e6
# Specific internal-energy floor in erg/g; explicit, no default is restored.
min_eint = 1e-10
compute_backend = cpu

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 0.1
max_steps = -1
restart = false
out_dir = output/validation/hydro/cylindrical
base_name = SmoothAdvection
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = -1
plt_variables = DENS, PRES, VELX, VELY, VELZ, ENER

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

rho_mean = 1.0
rho_amplitude = 0.2
pressure0 = 1.0
velocity0 = 1.0
mode = 1
mode_axis = 2
