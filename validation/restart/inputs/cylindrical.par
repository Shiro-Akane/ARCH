# Native cylindrical (r,z) CPU interface/fresh fixture using the existing Gaussian model.
# Three physical momenta; V and J are per unit azimuth. Closed radial walls and
# periodic z isolate restart/conservation behavior. Six fixed RK3 steps are a
# bounded interface witness, not a full scientific trajectory or GPU acceptance.
# Standard one-dimensional Sod shock-tube benchmark.





solver = HLLC
reconstruct = muscl
limiter = mc





# Explicit migration of previous effective controls; no new physical defaults.
compute_backend = cpu
sml_rho = 1e-12
min_eint = 1e-10
max_eint = 1e21
hll_wave_speed = roe
geometry=cylindrical
nblockx1=2
nblockx2=2
nblockx3=0
max_blocks=16
x1_min=1
x1_max=2
x2_min=-0.5
x2_max=0.5
x3_min=0
x3_max=0
x1l_boundary_type=reflecting
x1r_boundary_type=reflecting
x2l_boundary_type=periodic
x2r_boundary_type=periodic
x3l_boundary_type=outflow
x3r_boundary_type=outflow
time_integrator=RK3
cfl=0.3
dt_init=0.0001
dt_min=1e-12
dt_max=0.0001
tstep_change_factor=1
lrefinemin=0
lrefinemax=0
regrid_interval=2
refine_var=VELZ
refine_threshold=0.8
derefine_threshold=0.2
tmax=0.0006
max_steps=6
restart=false
out_dir=output/validation/restart/cylindrical-pwc
base_name=CylindricalPwc
plt_dt=-1
plt_dstep=1
chk_dt=-1
chk_dstep=3
plt_variables=DENS,PRES,TEMP,VELX,VELY,VELZ,ENER,VORT,DIVV
eos_type=ideal
gamma=1.4
gravity_type=none
use_burn=false
use_diffusion=false
network_name=none
rho0=1
p0=1
amp=0.2
width=0.3
xc=1.5
yc=0
zc=0
pressure_amplitude=0.05
u_amplitude=0
v_amplitude=0.03
w_amplitude=0.2
gas_cv=1
