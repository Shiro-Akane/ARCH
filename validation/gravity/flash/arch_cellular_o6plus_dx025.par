# O6+ larger-scale A: 64 x 32 cm, aligned 13 cm ignition radius and dx=0.25 cm.
# Its local pocket/ignition extension was run in pure-He planar mode.
# The same physical initial state and finest cell width are used by the O5
# comparison; this is an ARCH self-consistent-temperature burn, whereas the
# archived FLASH burner holds temperature fixed inside each burner call.
# FLASH reference uses eos_coulombMult=1 to retain the Helm Coulomb term.
# See validation/gravity/flash/O5OptimizationReport.zh-CN.md.
geometry=cartesian
nblockx1=8
nblockx2=4
nblockx3=0
max_blocks=512
x1_min=0
x1_max=64
x2_min=0
x2_max=32
x1l_boundary_type=reflecting
x1r_boundary_type=reflecting
x2l_boundary_type=periodic
x2r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.8
lrefinemin=0
lrefinemax=1
regrid_interval=2
refine_var=PRES,DENS,c12,ENUC
refine_threshold=0.8
derefine_threshold=0.2
tmax=1.0222428325150896e-08
max_steps=1000
dt_init=1e-16
dt_min=1e-20
tstep_change_factor=2.0
out_dir=output/cellular_o6plus_dx025
base_name=CellularMatched2D
plt_dt=-1
plt_dstep=1000
chk_dt=-1
chk_dstep=1000
plt_variables=ALL
restart=false
eos_type=helmholtz
eos_table_path=EOS_toolkit/tables/helmholtz/helm_table.dat
gravity_type=none
use_burn=true
network_name=aprox19
xhe4=1
xc12=0
xo16=0
nuclearTempMin=1e9
use_nse=false
ode_solver=bd
linear_solver=DenseLU
use_diffusion=false
rhoAmbient=2e7
tempAmbient=2e8
rhoPerturb=8e7
tempPerturb=3.5e9
velxPerturb=9.5e8
radiusPerturb=13.0
noiseAmplitude=0
shock_dir=0

compute_backend=cpu
