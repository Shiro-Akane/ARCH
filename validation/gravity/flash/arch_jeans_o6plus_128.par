# O6+ matched FLASH Jeans reference; both programs stop at tmax=0.1 s.
# CGS stable linear Jeans wave; the production solver subtracts mean density.
geometry=cartesian
nblockx1=8
nblockx2=8
nblockx3=0
max_blocks=256
x1_min=0
x1_max=1.14411
x2_min=0
x2_max=1.14411
x1l_boundary_type=periodic
x1r_boundary_type=periodic
x2l_boundary_type=periodic
x2r_boundary_type=periodic
x3l_boundary_type=periodic
x3r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.8
lrefinemin=0
lrefinemax=0
regrid_interval=2
refine_var=DENS
refine_threshold=0.8
derefine_threshold=0.2
tmax=0.1
max_steps=1000
out_dir=output/o6plus_jeans_arch_128
base_name=JeansWave
plt_dt=-1
chk_dt=-1
plt_variables=DENS,PRES,VELX,ENER
restart=false
eos_type=ideal
gamma=1.6666666666666667
gravity_type=self
use_burn=false
use_diffusion=false
rho0=1.5e7
pressure0=1.5e7
amplitude=0.001001608189083975

# Match FLASH 4.8 Jeans: point-centre amplitude corrected for ARCH
# cell averaging, mode=2, and zero initial velocity.
mode=2
standing_wave=true
gravity_G=6.67408e-8
gravity_rtol=1e-10
gravity_atol=0
dt_init=1e-10
dt_min=1e-20
plt_dstep=1000
chk_dstep=1000

compute_backend=cpu
