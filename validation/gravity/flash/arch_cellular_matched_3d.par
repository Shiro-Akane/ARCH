# Matched 3D control for the user-archive FLASH 4.8 Cellular case; gravity/diffusion off.
geometry=cartesian
nblockx1=4
nblockx2=2
nblockx3=1
max_blocks=512
x1_min=0
x1_max=64
x2_min=0
x2_max=32
x3_min=0
x3_max=16
x1l_boundary_type=reflecting
x1r_boundary_type=reflecting
x2l_boundary_type=periodic
x2r_boundary_type=periodic
x3l_boundary_type=periodic
x3r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.8
lrefinemin=0
lrefinemax=1
regrid_interval=2
refine_var=DENS
refine_threshold=0.8
derefine_threshold=0.2
tmax=4e-7
max_steps=20
dt_init=1e-16
dt_min=1e-20
tstep_change_factor=2.0
out_dir=output/flash_cellular_arch_control_3d
base_name=CellularMatched3D
plt_dt=-1
plt_dstep=20
chk_dt=-1
chk_dstep=20
plt_variables=ALL
restart=false
eos_type=helmholtz
eos_table_path=EOS_toolkit/tables/helmholtz/helm_table.dat
gravity_type=none
use_burn=true
network_name=aprox19
xhe4=1
xc12=0
xo16=0
nuclearTempMin=1e9
use_nse=false
ode_solver=bd
linear_solver=DenseLU
use_diffusion=false
rhoAmbient=2e7
tempAmbient=2e8
rhoPerturb=8e7
tempPerturb=3.5e9
velxPerturb=9.5e8
radiusPerturb=12.8
noiseAmplitude=0
shock_dir=0
