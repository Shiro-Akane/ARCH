# ARCH input used for the FLASH 4.8 Sod comparison: 4096 cells, HLLC/MC,
# gamma=1.4, outflow boundaries, and the exact FLASH terminal time.
# Both codes use their own time integrators and accepted-step counts.

geometry = cartesian

nblockx1 = 256
nblockx2 = 0
nblockx3 = 0
max_blocks = 256

x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0

x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.8

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 0.20004197244290714
max_steps = -1
out_dir = output/o6plus_sod_arch
base_name = Sod
plt_dt = -1
plt_dstep = 10000
chk_dt = -1
chk_dstep = 10000
plt_variables = DENS, PRES, VELX, ENER
restart = false

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

x_pos = 0.5
rho_left = 1.0
p_left = 1.0
u_left = 0.0
rho_right = 0.125
p_right = 0.1
u_right = 0.0

compute_backend=cpu
