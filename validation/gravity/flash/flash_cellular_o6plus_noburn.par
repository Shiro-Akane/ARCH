# Frozen FLASH 4.8 Cellular reference; compare actual checkpoint time with ARCH.
# flash file for a 1d, 2d, or 3d cellular detonation of carbon
# [source/Simulation/SimulationMain/Cellular]
# have changed into mixed situation!
# max and min levels of refinement
# 5 levels puts about 10 mesh points per burning length scale, and is about
# as crude a mesh as one dares to go. in 3d this is the most refinement
# levels i've run with. in 2d the most i've run it with is 8 levels in 2d,
# which makes some really great pictures.

lrefine_max = 2
lrefine_min = 1

# refine on the pressure and density
refine_var_1 = "pres"
refine_var_2 = "dens"
refine_var_3 = "c12"
refine_var_4 = "enuc"

# refine on the temperature too
#refine_var_1 = "pres"
#refine_var_2 = "dens"
#refine_var_3 = "temp"
#refine_var_4 = "none"

# names of files
basenm = "cellular_"
log_file = "cellular_log"

# for starting a new run
restart  = .false.
checkpointFileNumber = 0
plotFileNumber = 0

# specify the plot variables
plot_var_1 = "pres"
plot_var_2 = "si28"
plot_var_3 = "enuc"
plot_var_4 = "temp"
plot_var_5 = "c12"
plot_var_6 = "dens"
plot_var_7 = "ni56"
plot_var_8 = "velx"
plot_var_9 = "vely"
plot_var_10 = "shok"
plot_var_11 = "ti44"
plot_var_12 = "cr48"
plot_var_13 = "vort"
plot_var_14 = "magp"
plot_var_15 = "he4"


# for restarting an old one
#restart  = .true.
#checkpointFileNumber = 57
#plotFileNumber = 125


# dump checkpoint files every checkpointFileIntervalTime seconds
#checkpointFileIntervalTime   = 1.0e-9
checkpointFileIntervalStep = 1000

# dump plot files every plotFileIntervalTime seconds
#plotFileIntervalTime    = 0.25e-9
plotFileIntervalStep = 1000

# go for nend steps or tmax seconds, whichever comes first
nend = 1000
tmax = 1.0187727288607583e-8



# initial and minimum
dtinit = 1.0e-16
dtmin = 1.0e-20

# for fine time slices, you may want to limit the timestep
#dtmax = 0.0125e-9


# cfl limit, ni56 burner cutoff, artificial viscosity, smallest density
# allowed, and smallest temperature allowed
cfl = .8
nuclearNI56Max = 1.0
cvisc = 0.1
smlrho = 1.e-2
smallt = 1.e5


# choose integration method 1 = bader-deuflhard, 2 = rosenbrock
# rosenbrock is faster under some circumstances.
# until i test it some more, i'll stick with the bader-deuflhard.

odeStepper = 1


# choose linear algebra package 1 = ma28, 2 = gift
# gift is faster under some circumstances, and this problem
# satisfies those conditions. either package will get the right answer.

algebra = 2


# control when the burner is called, dont call it in the cold stuff
nuclearTempMin = 1.0e9
nuclearTempMax = 1.0e12
nuclearDensMin = 1.0e-10
nuclearDensMax = 1.0e14


# set the composition
xhe4 = 1.0
xc12 = 0.0
xo16 = 0.0


# upstream fuel conditions for pure carbon
tempAmbient   = 2.0e8
rhoAmbient = 2.0e7
velxAmbient   = 0.0e0


# these are the fuel conditions, for a self-sustained detonation
# at the upstream conditions, just after the shock has passed
# these values from /f1/fxt/flam/cjdet/cjdet.exe

tempPerturb   = 3.5e9
rhoPerturb = 8.0e7
velxPerturb   = 9.5E+08


# seed the density perturbations with white-noise
noiseAmplitude = 0.0
noiseDistance = 10.0


# physical domain
xmin = 0.0
xmax = 64.
ymin = 0.0
ymax = 32.
zmin = 0.0
zmax = 12.8


# put 20 blocks in the x-direction, this will give square grids
nblockx = 8
nblocky = 4
nblockz = 1


# apply the jump conditions below a distance of radiusPerturb
radiusPerturb = 12.8
xCenterPerturb = 0.
yCenterPerturb = 16.
zCenterPerturb = 0.
usePseudo1d = .true.



# cartesian geometry
geometry = "cartesian"

# reflecting east and west boundaries
xl_boundary_type = "reflect"
xr_boundary_type = "reflect"

# periodix north and south boundaries
yl_boundary_type = "periodic"
yr_boundary_type = "periodic"

# periodic up and down boundaries
zl_boundary_type = "periodic"
zr_boundary_type = "periodic"


# no gravity, but do burn
useBurn = .false.
useShockBurn = .true.
#ichem = 0

# eos options
eintSwitch     = 1.e-4
eos_coulombMult = 1

## -------------------------------------------------------------##
##  SWITCHES SPECIFIC TO THE UNSPLIT HYDRO SOLVER               ##
#	I. INTERPOLATION SCHEME:
order		= 2      # Interpolation order (first/second/third/fifth order)
slopeLimiter    = "mc"   # Slope limiters (minmod, mc, vanLeer, hybrid, limited)
LimitedSlopeBeta= 1.     # Slope parameter for the "limited" slope by Toro
charLimiting	= .true. # Characteristic limiting vs. Primitive limiting

use_avisc	= .false. # use artificial viscosity (originally for PPM)
#cvisc		= 0.1     # coefficient for artificial viscosity
use_flattening	= .false. # use flattening (dissipative) (originally for PPM)
use_steepening	= .false. # use contact steepening (originally for PPM)
use_upwindTVD	= .false. # use upwind biased TVD slope for PPM (need nguard=6)

#	II. RIEMANN SOLVERS:
RiemannSolver	= "HLLC"       # Roe, HLL, HLLC, LLF, Marquina
entropy         = .false.     # Entropy fix for the Roe solver


#	III. STRONG SHOCK HANDELING SCHEME:
shockDetect	= .false.     # Shock Detect for numerical stability
## -------------------------------------------------------------##

## ---------------------------------------------------------------##
##  SWITCHES SPECIFIC TO THE SUPER-TIME-STEPPING (STS) ALGORITHM  ##
##  NOTE: For details on using STS runtime parameters, please     ##
##        refer to user's guide (Driver chapter).                 ##
useSTS                  = .false.
nstepTotalSTS           = 5
nuSTS                   = 0.2
## ---------------------------------------------------------------##

#----------------------------------------------------------------------------
# Pocket Generation Parameters
#----------------------------------------------------------------------------

ignition_mode = 1 # 1 for plane, 0 for the circle

# --- mode select ---
# 1 = fixed N (Number), r (radii) random distributed at [min, max]
# 2 = fixed x (fraction), fixed r, N calculated
# 3 = fixed x (fraction), r at [min, max], N calculated
# 4 = uniformly mixed (no pockets)
pocket_mode = 4

# --- mode 1 & 3: range fo radii ---
pocket_r_min = 1.5
pocket_r_max = 5.0

# --- mode 1: fixed N ---
# (if pocket_mode = 1, vaild)
pocket_N = 20
pocket_manual_x_1 = 210
pocket_manual_y_1 = 16
pocket_manual_r_1 = 7

# --- mode 2: fixed r ---
# (if pocket_mode = 2, vaild)
pocket_r_fixed = 3.0

# --- mode 2, 3, 4: He fraction ---
# (if pocket_mode > 1, vaild)
pocket_vol_frac_he = 1.0

# --- constrains (Important!) ---
# aviod pocket in init-perturb
# (*** Must set same value as radiusPerturb ***)
pocket_avoid_radius = 50

# Pockets minimum distance
pocket_overlap_margin = 0.5

EOSforRiemann = .false.
