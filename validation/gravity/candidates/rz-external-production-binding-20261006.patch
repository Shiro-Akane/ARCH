 namespace TimeIntegration {
+// Private CPU external-source qualification is macro-step transactional.
+// Rejected numerical execution must not leave writable slots or flux budgets.
+class HydroCandidateTransaction {
+    amr::AMRControl& control_;
+    arch::scheduler::StageExecutionContext* context_=nullptr;
+    const Physical::Gravity::ExternalGravity* source_=nullptr;
+    std::optional<arch::state::StateResidencyLedger::HostRollback> ledger_;
+    std::optional<amr::FluxRegister::HostRollback> flux_;
+    arch::scheduler::MonotonicSchedulerClock clock_;
+    struct Saved {int id;FluidState current,next,scratch;};
+    std::vector<Saved> states_;
+    int exceptions_=std::uncaught_exceptions();
+    std::size_t budget_size_=0;
+public:
+    HydroCandidateTransaction(amr::AMRControl& control,const Physical::Gravity::IGravityPolicy* gravity):control_(control) {
+        const auto* source=dynamic_cast<const Physical::Gravity::ExternalGravity*>(gravity);
+        if(!source||!source->stage_service_bound()
+            ||source->source_contract().chart!=GridMetrics::GeometrySemantics::AxisymmetricRz)return;
+        auto& context=arch::scheduler::current_stage_binding().context;
+        if(context.side!=arch::state::ExecutionSide::Host)throw std::logic_error("Private RZ rollback is Host-only");
+        context_=&context;source_=source;clock_=context.clock;budget_size_=source->accepted_budgets().size();
+        ledger_.emplace(context.ledger.checkpoint_host_hydro());
+        flux_.emplace(control.flux_register.checkpoint_host_hydro());
+        for(int id:control.tree->GetActiveBlocks()) {
+            const auto& block=control.pool->GetBlock(id);
+            states_.push_back({id,block.fluid_state,block.state_next,block.state_scratch});
+        }
+    }
+    ~HydroCandidateTransaction() noexcept {
+        if(!context_||std::uncaught_exceptions()==exceptions_)return;
+        for(auto& saved:states_) {
+            auto& block=control_.pool->GetBlock(saved.id);
+            std::swap(block.fluid_state,saved.current);std::swap(block.state_next,saved.next);
+            std::swap(block.state_scratch,saved.scratch);
+        }
+        control_.flux_register.rollback_host_hydro(std::move(*flux_));
+        context_->ledger.rollback_host_hydro(std::move(*ledger_));
+        context_->clock=clock_;
+        source_->invalidate_prepared();source_->rollback_budgets(budget_size_);
+    }
+    HydroCandidateTransaction(const HydroCandidateTransaction&)=delete;
+    HydroCandidateTransaction& operator=(const HydroCandidateTransaction&)=delete;
+};
