diff --git a/src/driver/stages/RzExternalStage.h b/src/driver/stages/RzExternalStage.h
new file mode 100644
--- /dev/null
+++ b/src/driver/stages/RzExternalStage.h
@@ -0,0 +1,84 @@
+#pragma once
+#include "driver/runtime/DriverRuntime.h"
+#include "driver/schedule/DriverControl.h"
+#include "numerics/integrator/IHydroSolver.h"
+namespace arch::driver {
+// Private CPU qualification adapter, not selected from SimConfig/API.
+class RzExternalStage final:public scheduler::HydroStagePreparation {
+    DriverRuntime& runtime_;
+    const Physical::Gravity::ExternalGravity& source_;
+    const Numerics::IHydroSolver& hydro_;
+    const GravityConfig configuration_;
+    scheduler::StageDescriptor descriptor_{};
+    double dt_=0.;
+    Physical::Gravity::ExternalGravity::RzStageIdentity frame(std::size_t index) const {
+        using state::StateSlot;
+        const auto& cfg=runtime_.configuration().physics.gravity;
+        if(cfg!=configuration_||cfg.type!="external"
+           ||cfg.g_x!=source_.g_x||cfg.g_y!=source_.g_y||cfg.g_z!=source_.g_z)
+            throw std::invalid_argument("External source configuration owner changed");
+        const auto h=runtime_.handles().at(index);
+        auto context=runtime_.stage_context();
+        const auto version=context.ledger.inspect({h,descriptor_.input_slot}).interior.version;
+        context.ledger.require_readable({h,descriptor_.input_slot},{state::ExecutionSide::Host,version,true,true});
+        const auto& block=runtime_.control().pool->GetBlock(runtime_.control().tree->GetActiveBlocks().at(index));
+        const auto& input=descriptor_.input_slot==StateSlot::Current?block.fluid_state:
+            descriptor_.input_slot==StateSlot::Next?block.state_next:block.state_scratch;
+        return {Physical::Gravity::GravitySourceOrigin::ExternalNativeOrthonormal,
+            runtime_.geometry_semantics(),h,descriptor_.input_slot,version,
+            runtime_.host_storage_generation(index).value,runtime_.source_configuration_lease(),
+            runtime_.macro_step(),descriptor_.stage,{cfg.g_x,cfg.g_y,cfg.g_z},&input,
+            runtime_.current_time()+descriptor_.input_time_fraction*dt_,dt_};
+    }
+public:
+    RzExternalStage(DriverRuntime& runtime,const Physical::Gravity::ExternalGravity& source,
+        const Numerics::IHydroSolver& hydro):runtime_(runtime),source_(source),hydro_(hydro),
+        configuration_(runtime.configuration().physics.gravity) {
+        if(runtime.backend()||runtime.geometry_semantics()!=GridMetrics::GeometrySemantics::AxisymmetricRz
+           ||hydro.geometry_semantics()!=runtime.geometry_semantics()
+           ||source.source_contract().chart!=runtime.geometry_semantics())
+            throw std::invalid_argument("Private RZ external qualification requires consistent CPU owners");
+        source_.bind_stage_service(true);
+    }
+    ~RzExternalStage() {source_.bind_stage_service(false);}
+    state::CompletionToken prepare(const scheduler::HydroStagePreparationRequest& request) override {
+        source_.invalidate_prepared();
+        auto context=runtime_.stage_context();
+        if(request.side!=state::ExecutionSide::Host||&request.ledger!=&context.ledger
+           ||request.handles.size()!=runtime_.handles().size()
+           ||!std::equal(request.handles.begin(),request.handles.end(),runtime_.handles().begin())
+           ||request.descriptor.stage<=0||!std::isfinite(request.input_time))
+            throw std::invalid_argument("External source request is not actual Runtime stage");
+        const auto plan=scheduler::make_hydro_plan(request.method);
+        const auto found=std::find_if(plan.stages.begin(),plan.stages.end(),
+            [&](const auto& d){return d.stage==request.descriptor.stage;});
+        const auto& d=request.descriptor;
+        if(found==plan.stages.end()||d.old_slot!=found->old_slot||d.input_slot!=found->input_slot
+            ||d.output_slot!=found->output_slot||d.old_weight!=found->old_weight
+            ||d.update_weight!=found->update_weight||d.flux_register_weight!=found->flux_register_weight
+            ||d.input_requires_ghost!=found->input_requires_ghost||d.refresh_ghost_after!=found->refresh_ghost_after
+            ||d.input_time_fraction!=found->input_time_fraction
+            ||!std::isfinite(request.step_dt)||request.step_dt<=0.
+            ||request.input_time!=runtime_.current_time()+d.input_time_fraction*request.step_dt)
+            throw std::invalid_argument("External source canonical RK/time identity mismatch");
+        descriptor_=request.descriptor;dt_=request.step_dt;
+        std::vector<Physical::Gravity::ExternalGravity::PreparedPatch> candidate;
+        for(std::size_t i=0;i<request.handles.size();++i) {
+            const auto identity=frame(i);
+            const auto& block=runtime_.control().pool->GetBlock(runtime_.control().tree->GetActiveBlocks().at(i));
+            candidate.push_back({identity,&block.grid,dt_,
+                hydro_.prepare_rz_external(source_,*identity.state,block.grid,dt_,identity,request.ledger)});
+        }
+        source_.publish_prepared(std::move(candidate),[this](std::size_t i){return frame(i);});
+        return {request.ledger.inspect({request.handles.front(),descriptor_.input_slot}).interior.completion.value,
+                state::CompletionState::Complete};
+    }
+    void accept(const scheduler::StageDescriptor& descriptor) const {
+        if(descriptor.stage!=descriptor_.stage||descriptor.input_slot!=descriptor_.input_slot
+            ||descriptor.flux_register_weight!=descriptor_.flux_register_weight)
+            throw std::logic_error("Source budget acceptance stage mismatch");
+        source_.accept_prepared_stage(descriptor.flux_register_weight);
+    }
+    void invalidate() const override {source_.invalidate_prepared();}
+};
+}
