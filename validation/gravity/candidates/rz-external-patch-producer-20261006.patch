+/** Stage integrals supplied by an authoritative physical-field producer.
+ * Momentum r/z and energy use V; angular impulse uses W. These are source
+ * rates, not stored representative cell values. Integrals include full 2*pi.
+ * The stage owner validates source/chart/epoch and positive native measures
+ * before this arithmetic leaf. No callback/source traversal is introduced here.
+ */
+struct ExternalRzStageIntegrals {
+    double volume=0.0;
+    double angular_measure=0.0;
+    double radial_momentum_rate=0.0;
+    double axial_momentum_rate=0.0;
+    double angular_momentum_rate=0.0;
+    double energy_rate=0.0;
+};
+ARCH_INLINE void add_external_rz_stage_integrals(
+    const ExternalRzStageIntegrals& source, double dt, FluidVector& delta)
+{
+    delta.mom_u += dt * source.radial_momentum_rate / source.volume;
+    delta.mom_v += dt * source.axial_momentum_rate / source.volume;
+    delta.mom_w += dt * source.angular_momentum_rate / source.angular_measure;
+    delta.eng += dt * source.energy_rate / source.volume;
+}
