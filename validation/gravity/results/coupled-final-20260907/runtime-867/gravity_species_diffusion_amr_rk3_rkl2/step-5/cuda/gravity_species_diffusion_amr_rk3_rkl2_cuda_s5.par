# Localized Cartesian species pulse for real GPU-AMR diffusion validation.
geometry = cartesian
nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 64
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = periodic
x1r_boundary_type = periodic
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK3
cfl = 0.4
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cuda

lrefinemin = 0
lrefinemax = 1
regrid_interval = 1
refine_var = SPECIES
refine_threshold = 0.7
derefine_threshold = 0.15

tmax = 1e99
max_steps = 5
restart = false
out_dir = /home/shiroakane/ARCH/validation/gravity/results/coupled-final-20260907/runtime-867/gravity_species_diffusion_amr_rk3_rkl2/step-5/cuda
base_name = gravity_species_diffusion_amr_rk3_rkl2_cuda_s5
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 5
plt_variables = DENS, PRES, SPECIES

eos_type = ideal
gamma = 1.4
# Ordinary passive gases with positive heat capacity; no nuclear network.
network_name = none
gas_cv = 717.5
gravity_type = external
use_burn = false

use_diffusion = true
diff_integrator = RKL2
diff_cfl = 0.8
diff_max_stages = 5
use_thermal_diff = false
use_viscous_diff = false
use_species_diff = true
D_spec = 0.5

rho0 = 1.0
p0 = 1.0
amp = 0.5
width = 0.08
xc = 0.5
pressure0 = 1.0
pressure_amplitude = 0.0
velocity_x0 = 0.0
u_amplitude = 0.0
v_amplitude = 0.0
w_amplitude = 0.0
gravity_g_x = 1.0
gravity_g_y = 0.0
gravity_g_z = 0.0
