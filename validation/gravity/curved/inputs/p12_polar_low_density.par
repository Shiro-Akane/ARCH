# Near-vacuum 2D polar origin using the existing density-floor control.
compute_backend=cpu
geometry=cylindrical
nblockx1=2
nblockx2=2
nblockx3=0
max_blocks=128
x1_min=0
x1_max=1e8
x1l_boundary_type=reflecting
x1r_boundary_type=outflow
x2l_boundary_type=periodic
x2r_boundary_type=periodic
x3l_boundary_type=periodic
x3r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK3
cfl=1e-6
lrefinemin=0
lrefinemax=1
regrid_interval=2
refine_var=DENS
refine_threshold=0.005
derefine_threshold=0.001
tmax=1e-6
max_steps=2
out_dir=output/gravity/p12_polar_low_density
base_name=P12LowDensity
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,VELY,ENER
restart=false
eos_type=ideal
gamma=1.6666666666666667
gravity_type=self
gravity_boundary=isolated
use_burn=false
use_diffusion=false
rho0=1e-12
temperature0=1e7
amplitude=0.05
x2_min=0
x2_max=6.283185307179586
center_x=2e7
center_y=0
width=1e7
dt_init=1e-8
dt_min=1e-20
tstep_change_factor=1.0
sml_rho=1e-13
