# New full-ring Native RZ representative input; historical polar acceptance does not transfer.
# r domain/numerics retained; axial z[0,1e8] cm with outflow; execution remains qualification-gated.
compute_backend=cpu
geometry=cylindrical
nblockx1=2
nblockx2=2
nblockx3=0
max_blocks=128
x1_min=0
x1_max=1e8
x1l_boundary_type=reflecting
x1r_boundary_type=outflow
x2l_boundary_type=outflow
x2r_boundary_type=outflow
x3l_boundary_type=periodic
x3r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK3
cfl=1e-6
lrefinemin=0
lrefinemax=1
regrid_interval=2
refine_var=DENS
refine_threshold=0.005
derefine_threshold=0.001
tmax=1e-6
max_steps=2
out_dir=output/gravity/rz_low_density
base_name=RzLowDensity
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,VELY,ENER
restart=false
eos_type=ideal
gamma=1.6666666666666667
gravity_type=self
gravity_boundary=isolated
use_burn=false
use_diffusion=false
rho0=1e-12
temperature0=1e7
amplitude=0.05
x2_min=0
x2_max=1e8
center_x=2e7
center_y=0
width=1e7
dt_init=1e-8
dt_min=1e-20
tstep_change_factor=1.0
sml_rho=1e-13
center_z=0

# Explicit shared GravityBox gas/EOS/solver controls; density and floor remain this input.
min_eint=1e-10
max_eint=1e21
hll_wave_speed=roe
gravity_rtol=1e-10
gravity_atol=0.0
network_name=none
gas_cv=1.2471693927e8
temperature_amplitude=0.0
velocity0=0.0
hydrostatic_radial=false
