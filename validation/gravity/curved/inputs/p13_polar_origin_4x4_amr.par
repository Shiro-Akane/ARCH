# P13 2D full-azimuth polar origin, 4x4 root blocks, amr CPU/CUDA comparison.
compute_backend=cpu
geometry=cylindrical
nblockx1=4
nblockx2=4
nblockx3=0
max_blocks=256
x1_min=0
x1_max=1.5
x2_min=0
x2_max=6.283185307179586
x1l_boundary_type=reflecting
x1r_boundary_type=outflow
x2l_boundary_type=periodic
x2r_boundary_type=periodic
solver=HLLC
reconstruct=muscl
limiter=mc
time_integrator=RK2
cfl=0.3
lrefinemin=0
lrefinemax=1
tmax=1e-7
max_steps=3
dt_init=2.5e-11
dt_min=1e-20
tstep_change_factor=1.0
out_dir=output/gravity/p13_polar_origin_4x4_amr
base_name=P13Polar4x4Amr
plt_dt=-1
plt_dstep=-1
chk_dt=-1
chk_dstep=-1
plt_variables=DENS,PRES,TEMP,VELX,VELY,ENER,ENUC,SPECIES
restart=false
eos_type=helmholtz
eos_table_path=EOS_toolkit/tables/helmholtz/helm_table.dat
gravity_type=self
gravity_boundary=isolated
use_burn=true
network_name=aprox13
xhe4=0
xc12=0.5
xo16=0.5
nuclearTempMin=8e8
use_nse=false
ode_solver=bd
linear_solver=DenseLU
use_diffusion=true
use_thermal_diff=true
diff_integrator=RKL2
rho0=1e7
temperature0=1e9
temperature_peak=3e9
density_amplitude=0.05
hotspot_width=0.1
center_x=0
center_y=0.75
regrid_interval=2
refine_var=DENS
refine_threshold=0.005
derefine_threshold=0.001
gravity_rtol=1e-08
