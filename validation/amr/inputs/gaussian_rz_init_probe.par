# Engineering init-only registration/profile probe; not a frozen scientific benchmark.
geometry = cylindrical
nblockx1 = 1
nblockx2 = 1
nblockx3 = 0
max_blocks = 4
x1_min = 0.0
x1_max = 1.0
x2_min = -0.5
x2_max = 0.5
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow
solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2
tmax = 0.2
max_steps = -1
out_dir = output/sod_standard
base_name = Sod
plt_dt = 0.05
plt_dstep = -1
chk_dt = -1.0
chk_dstep = -1
plt_variables = DENS, PRES, VELX, ENER
restart = false
eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false
compute_backend = cpu
sml_rho = 1e-12
min_eint = 1e-10
max_eint = 1e21
hll_wave_speed = roe
network_name = none
rho0 = 2.0
p0 = 5.0
amp = 0.5
width = 0.2
xc = 0.5
yc = 0.0
zc = 0.25
pressure_amplitude = 0.0
u_amplitude = 0.0
v_amplitude = 0.0
w_amplitude = 0.0
gas_cv = 2.0
