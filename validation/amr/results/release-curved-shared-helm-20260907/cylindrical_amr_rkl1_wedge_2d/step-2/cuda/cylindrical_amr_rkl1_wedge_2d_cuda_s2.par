# Localized Cartesian species pulse for real GPU-AMR diffusion validation.
geometry = cylindrical
nblockx1 = 8
nblockx2 = 2
nblockx3 = 0
max_blocks = 128
x1_min = 1.0
x1_max = 3.0
x2_min = -0.25
x2_max = 0.25
x3_min = -0.25
x3_max = 0.25
x1l_boundary_type = reflecting
x1r_boundary_type = reflecting
x2l_boundary_type = reflecting
x2r_boundary_type = reflecting
x3l_boundary_type = reflecting
x3r_boundary_type = reflecting

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cuda

lrefinemin = 0
lrefinemax = 1
regrid_interval = 1
refine_var = SPECIES
refine_threshold = 0.7
derefine_threshold = 0.15

tmax = 1e99
max_steps = 2
restart = false
out_dir = /home/shiroakane/ARCH/validation/amr/results/release-curved-shared-helm-20260907/cylindrical_amr_rkl1_wedge_2d/step-2/cuda
base_name = cylindrical_amr_rkl1_wedge_2d_cuda_s2
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 2
plt_variables = DENS, PRES, SPECIES

eos_type = ideal
gamma = 1.4
# Ordinary passive gases with positive heat capacity; no nuclear network.
network_name = none
gas_cv = 717.5
gravity_type = none
use_burn = false

use_diffusion = true
diff_integrator = RKL1
diff_cfl = 0.8
diff_max_stages = 5
use_thermal_diff = false
use_viscous_diff = false
use_species_diff = true
D_spec = 0.5

rho0 = 1.0
p0 = 1.0
amp = 0.5
width = 0.08
xc = 1.5
