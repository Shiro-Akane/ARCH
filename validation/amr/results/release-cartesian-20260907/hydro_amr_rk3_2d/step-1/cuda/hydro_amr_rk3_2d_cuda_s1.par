# Regularized 2D Cartesian Sedov AMR conservation and symmetry diagnostic.
# AMR VALIDATION INPUT: two-dimensional refinement, reflux, and species transport.
geometry = cartesian
nblockx1 = 4
nblockx2 = 4
nblockx3 = 0
max_blocks = 512
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = ppm
limiter = mc
time_integrator = RK3
cfl = 0.4
compute_backend = cuda

lrefinemin = 0
lrefinemax = 1
regrid_interval = 1
refine_var = DENS, PRES
refine_threshold = 0.2
derefine_threshold = 0.05

tmax = 1e99
max_steps = 1
restart = false
out_dir = /home/shiroakane/ARCH/validation/amr/results/release-cartesian-20260907/hydro_amr_rk3_2d/step-1/cuda
base_name = hydro_amr_rk3_2d_cuda_s1
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 1
plt_variables = DENS, PRES, VELX, VELY, ENER, SPECIES

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

center_x = 0.5
center_y = 0.5
deposit_radius = 0.03
ambient_density = 1.0
ambient_pressure = 1.0e-5
explosion_energy = 1.0
