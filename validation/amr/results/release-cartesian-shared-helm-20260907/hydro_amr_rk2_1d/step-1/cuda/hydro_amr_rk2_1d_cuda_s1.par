# Smooth periodic entropy-wave advection: MUSCL, 80-cell root grid with one AMR level.
# AMR VALIDATION INPUT: refinement, interface-crossing, and conservation case.
geometry = cartesian
nblockx1 = 5
nblockx2 = 0
nblockx3 = 0
max_blocks = 128
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = periodic
x1r_boundary_type = periodic
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.3
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cuda

lrefinemin = 0
lrefinemax = 1
regrid_interval = 1
refine_var = DENS
refine_threshold = 0.035
derefine_threshold = 0.002

tmax = 1e99
max_steps = 1
restart = false
out_dir = /home/shiroakane/ARCH/validation/amr/results/release-cartesian-shared-helm-20260907/hydro_amr_rk2_1d/step-1/cuda
base_name = hydro_amr_rk2_1d_cuda_s1
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 1
plt_variables = DENS, PRES, VELX, ENER

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

rho_mean = 1.0
rho_amplitude = 0.2
pressure0 = 1.0
velocity0 = 1.0
mode = 1
