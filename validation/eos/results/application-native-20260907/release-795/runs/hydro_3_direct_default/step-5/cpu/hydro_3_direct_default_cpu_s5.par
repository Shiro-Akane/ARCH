# Smooth periodic entropy-wave advection: MUSCL, 80-cell root grid with one AMR level.
# AMR VALIDATION INPUT: refinement, interface-crossing, and conservation case.
geometry = cartesian
nblockx1 = 5
nblockx2 = 0
nblockx3 = 0
max_blocks = 128
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = periodic
x1r_boundary_type = periodic
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK3
cfl = 0.3
sml_rho = 1e-12
max_eint = 1e22
compute_backend = cpu

lrefinemin = 0
lrefinemax = 1
regrid_interval = 1
refine_var = DENS
refine_threshold = 0.035
derefine_threshold = 0.002

tmax = 1e99
max_steps = 5
restart = false
out_dir = /home/shiroakane/ARCH/validation/eos/results/application-native-20260907/release-795/runs/hydro_3_direct_default/step-5/cpu
base_name = hydro_3_direct_default_cpu_s5
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 5
plt_variables = DENS,TEMP,PRES,ENER,ENUC,SPECIES

eos_type = tabular
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

rho_mean = 10
rho_amplitude = 2
pressure0 = 1e16
velocity0 = 1e7
mode = 1
eos_table_path = /home/shiroakane/ARCH/validation/eos/results/application-native-20260907/release-795/tables/hydro-3-direct.h5
