# Uniform Sod shock tube: PPM, 64 cells, four root blocks.
geometry = cartesian
nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 12
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow
solver = HLLC
reconstruct = ppm
limiter = mc
time_integrator = RK3
cfl = 0.4
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cpu
lrefinemin = 0
lrefinemax = 0
regrid_interval = 1000
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2
tmax = 0.2
max_steps = -1
restart = false
out_dir = /home/shiroakane/ARCH/validation/backend/results/uniform-native-20260907/release-874/sod_ppm_n64/scientific/cpu
base_name = sod_ppm_n64_cpu_scientific
plt_dt = -1
plt_dstep = -1
chk_dt = 0.2
chk_dstep = -1
plt_variables = DENS, PRES, VELX, ENER
eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false
x_pos = 0.5
rho_left = 1.0
p_left = 1.0
u_left = 0.0
rho_right = 0.125
p_right = 0.1
u_right = 0.0
