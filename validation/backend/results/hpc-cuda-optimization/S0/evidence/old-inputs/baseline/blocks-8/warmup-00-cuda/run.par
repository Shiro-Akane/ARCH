# Standard teaching configuration for a regularized 2D Cartesian Sedov blast.
# The finite deposition radius is explicit; this is not a singular point source.

geometry = cartesian

nblockx1 = 8
nblockx2 = 8
nblockx3 = 0
max_blocks = 2048

x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0

x1l_boundary_type = outflow
x1r_boundary_type = outflow
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = ppm
limiter = mc
time_integrator = RK3
cfl = 0.4

lrefinemin = 0
lrefinemax = 2
regrid_interval = 2
refine_var = DENS, PRES
refine_threshold = 0.4
derefine_threshold = 0.1

tmax = 0.02
max_steps = -1
out_dir = /home/ubuntu/projects/ARCH-perf-20260909/build/performance-20260909/baseline/blocks-8/warmup-00-cuda
base_name = SedovTiming
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = -1
plt_variables = DENS, PRES, VELX, VELY, ENER
restart = false

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false
use_diffusion = false

center_x = 0.5
center_y = 0.5
deposit_radius = 0.03
ambient_density = 1.0
ambient_pressure = 1.0e-5
explosion_energy = 1.0
compute_backend = cuda
