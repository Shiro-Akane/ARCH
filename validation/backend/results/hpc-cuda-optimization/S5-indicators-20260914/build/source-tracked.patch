+ARCH_DEFINE_REFINEMENT_INDICATORS(HelmEosView)
+ARCH_DEFINE_REFINEMENT_INDICATORS(Tabular3DEOSView)
+ARCH_DEFINE_REFINEMENT_INDICATORS(Tabular4DEOSView)
 #undef ARCH_DEFINE_REFINEMENT_INDICATORS
 
