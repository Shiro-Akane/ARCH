+{
+    int devices = 0;
+    const auto probe = cudaGetDeviceCount(&devices);
+    if (probe == cudaErrorNoDevice || probe == cudaErrorInsufficientDriver
+        || (probe == cudaSuccess && devices == 0)) return 77;
+    if (probe != cudaSuccess) {
+        std::cerr << cudaGetErrorString(probe) << '\n';
+        return 1;
+    }
