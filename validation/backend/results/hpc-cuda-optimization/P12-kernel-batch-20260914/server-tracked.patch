+        Tabular3DEOSView table3{};
+        table3.n_rho = table3.n_T = table3.n_X = 2;
+        table3.log_rho_max = table3.log_T_max = 1.0;
+        table3.dlog_rho = table3.dlog_T = table3.dX = 1.0;
+        table3.X_max = 1.0; table3.target_species_id = -1;
