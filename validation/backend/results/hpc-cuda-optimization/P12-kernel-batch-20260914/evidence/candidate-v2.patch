+def _launch_quiesces_before_kernel_count(
+        body: str, launch_pattern: str) -> bool:
+    return _matches_in_order(
+        body,
+        launch_pattern,
+        r"\bquiesce\s*\(\s*\)\s*;",
+        r"impl_->runtime_counters\.kernel_count\s*\+=")
