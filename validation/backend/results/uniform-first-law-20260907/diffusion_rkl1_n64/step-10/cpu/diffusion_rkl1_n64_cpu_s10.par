# Periodic cosine-mode species diffusion: RKL1, 64 cells.
# VALIDATION INPUT: owned by validation/diffusion/README.md; keep synchronized with metrics.csv.
geometry = cartesian
nblockx1 = 4
nblockx2 = 0
nblockx3 = 0
max_blocks = 12
x1_min = 0.0
x1_max = 1.0
x2_min = 0.0
x2_max = 1.0
x3_min = 0.0
x3_max = 1.0
x1l_boundary_type = periodic
x1r_boundary_type = periodic
x2l_boundary_type = outflow
x2r_boundary_type = outflow
x3l_boundary_type = outflow
x3r_boundary_type = outflow

solver = HLLC
reconstruct = muscl
limiter = mc
time_integrator = RK2
cfl = 0.4
sml_rho = 1e-12
max_eint = 1e6
compute_backend = cpu

lrefinemin = 0
lrefinemax = 0
regrid_interval = 2
refine_var = DENS
refine_threshold = 0.8
derefine_threshold = 0.2

tmax = 1e99
max_steps = 10
restart = false
out_dir = /home/shiroakane/ARCH/validation/backend/results/uniform-first-law-20260907/diffusion_rkl1_n64/step-10/cpu
base_name = diffusion_rkl1_n64_cpu_s10
plt_dt = -1
plt_dstep = -1
chk_dt = -1
chk_dstep = 10
plt_variables = DENS, PRES, VELX, tracer

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = false

use_diffusion = true
diff_integrator = RKL1
diff_cfl = 0.8
diff_max_stages = 256
use_thermal_diff = false
use_viscous_diff = false
use_species_diff = true
D_spec = 0.01

rho0 = 1.0
pressure0 = 1.0
tracer_mean = 0.5
tracer_amplitude = 0.25
mode = 1
