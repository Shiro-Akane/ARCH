# 编译输出
build/
/build*/
bin/
*.o
*.out

# 本地模拟输出
output/

# Validation summaries, inputs and logs belong in Git. Generated checkpoints
# and plots stay beside them locally, or in a separately published data archive.
# This does not exclude EOS inputs or remove already tracked reference data.
/validation/**/results/**/*.h5
__pycache__/

# 系统与编辑器文件
.vscode/
.DS_Store

# Local credentials and environment settings. Keep sanitized examples usable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.netrc
.pypirc
.npmrc
/.aws/
/.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.key
*.pem
*.p12
*.pfx
# Public certificates and scientific key data can be intentionally tracked;
# review their contents instead of force-adding an entire credentials directory.
