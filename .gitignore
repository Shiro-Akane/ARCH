# 编译输出
build/
/build*/
bin/
*.o
*.out

# 本地模拟输出
output/

# Validation summaries, inputs and compact references belong in Git. Generated
# state and per-step raw transcripts remain local; curated EOS/test inputs and
# processed reference TSV are unaffected.
/validation/**/results/**/*.h5
/validation/**/results/**/*_backend_trace.tsv
/validation/**/results/**/gravity_solves.tsv
/validation/**/results/**/*_log.dat
/validation/**/results/**/*.stdout
/validation/**/results/**/*.stderr
__pycache__/

# 系统与编辑器文件
.vscode/
.DS_Store

# Local credentials and environment settings. Keep sanitized examples usable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.netrc
.pypirc
.npmrc
/.aws/
/.ssh/
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.key
*.pem
*.p12
*.pfx
# Public certificates and scientific key data can be intentionally tracked;
# review their contents instead of force-adding an entire credentials directory.
