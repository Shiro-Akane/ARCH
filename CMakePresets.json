{
  "version": 1,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "CPU application (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARCH_ENABLE_CUDA": "OFF",
        "ARCH_ENABLE_OPENMP": "ON",
        "BUILD_TESTING": "OFF",
        "ARCH_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-cpu/bin"
      }
    },
    {
      "name": "studio-cpu-release",
      "displayName": "CPU application and Linux Studio desktop (Release)",
      "inherits": "cpu-release",
      "binaryDir": "${sourceDir}/build-studio-cpu",
      "cacheVariables": {
        "ARCH_BUILD_STUDIO": "ON",
        "ARCH_EMIT_LINK_DEPENDENCIES": "ON",
        "ARCH_RETAIN_LTO_LINK_INPUTS": "ON",
        "ARCH_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-studio-cpu/bin"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA application (Release, visible GPU)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARCH_ENABLE_CUDA": "ON",
        "ARCH_ENABLE_OPENMP": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARCH_CUDA_HEAVY_COMPILE_JOBS": "1",
        "ARCH_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-cuda/bin"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "CUDA development (Debug, visible GPU)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ARCH_ENABLE_CUDA": "ON",
        "ARCH_ENABLE_OPENMP": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "ARCH_CUDA_HEAVY_COMPILE_JOBS": "1",
        "ARCH_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-cuda-debug/bin"
      }
    }
  ]
}
