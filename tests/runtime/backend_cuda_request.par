max_steps = 0
out_dir = output/backend_cuda_request
base_name = backend_cuda_request
plt_dt = -1.0
plt_dstep = -1
chk_dt = -1.0
chk_dstep = -1

eos_type = ideal
gamma = 1.4
gravity_type = none
use_burn = 0

shape_type = 0
shock_dir = 0
