nx = 8
ny = 2
nz = 1
x_min = 0.0
x_max = 8.0
y_min = 0.0
y_max = 2.0
z_min = 0.0
z_max = 1.0
geometry = cartesian
xl_boundary_type = reflect
xr_boundary_type = outflow
yl_boundary_type = periodic
yr_boundary_type = periodic
zl_boundary_type = outflow
zr_boundary_type = outflow

solver = HLLC
reconstruct = pcm
time_integrator = Euler
limiter = minmod
cfl = 0.5
compute_backend = cpu
sml_rho = 1.0e-2
max_eint = 1.0e21

tmax = 1.0e-16
max_steps = 1
out_dir = output/cellular_burner_handle_smoke
base_name = cellular_burner_handle_smoke
plt_dt = -1.0
plt_dstep = -1
chk_dt = -1.0
chk_dstep = -1

eos_type = helmholtz
eos_table_path = /home/ubuntu/ARCHcuda/burnbench/helm_table.dat
gravity_type = none

use_burn = 1
network_name = aprox13
use_nse = 0
nuclearTempMin = 1.0e7
nuclearDensMin = 1.0e-10
burn_verbose_level = 0
enucDtFactor = 1.0e30
ode_solver = BE_NR
linear_solver = DenseLU
ode_rtol = 1.0e-4
ode_atol = 1.0e-8
ode_max_newton_iter = 50
ode_max_substeps = 10000
ode_initial_dt_frac = 1.0e-3
dt_init = 1.0e-16

shock_dir = 0
radiusPerturb = 4.0
rhoAmbient = 1.0e7
tempAmbient = 2.0e8
rhoPerturb = 4.322e7
tempPerturb = 3.0e9
velxPerturb = 1.011e9
noiseAmplitude = 0.0
xhe4 = 0.4
xc12 = 0.6
xo16 = 0.0
